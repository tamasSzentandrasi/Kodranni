---
import { FORTUNE_LABELS } from '../data/load';
import { FORTUNE_BLURBS } from '../lib/format';

interface Props {
  fortunes: Record<string, number>;
}

const { fortunes } = Astro.props;
const fortuneOrder = ['vitality', 'cohesion', 'surplus', 'standing', 'tradition'] as const;
---

<section class="hall__sky" aria-labelledby="f-h">
  <div class="section-head">
    <h2 id="f-h">Fortunes</h2>
    <button
      type="button"
      class="info"
      data-tip="Community-wide pressure — not a second character sheet. Soft scale: Crisis 0 → Abundance 3."
      aria-label="About Fortunes"
    >
      i
    </button>
  </div>
  <div class="fortune-hall" role="list">
    {
      fortuneOrder.map((k) => {
        const v = Math.min(3, Math.max(0, fortunes[k] ?? 0));
        const label = FORTUNE_LABELS[v] ?? '';
        const crisis = v === 0;
        return (
          <div
            class="kod-plate fortune"
            data-key={k}
            data-level={String(v)}
            role="listitem"
            aria-label={`${k}, ${label}`}
          >
            <span class="fortune__icon" aria-hidden="true" />
            <span class="fortune__name">{k}</span>
            <div class="fortune__well" aria-hidden="true">
              <span class="fortune__fill" />
              {crisis && <span class="fortune__ember" />}
            </div>
            <span class="fortune__state">{label}</span>
            <details class="fortune__blurb">
              <summary aria-label={k}>
                <span class="fortune__blurb-mark" aria-hidden="true">◆</span>
              </summary>
              <p>{FORTUNE_BLURBS[k] ?? ''}</p>
            </details>
          </div>
        );
      })
    }
  </div>
</section>
