---
import { FORTUNE_LABELS } from '../data/load';
import { FORTUNE_BLURBS } from '../lib/format';

interface Props {
  fortunes: Record<string, number>;
  /** Storyteller desk — pillars cycle weather; hall is read-only. */
  editable?: boolean;
  /** Live store already has fortunesFoundedAt. */
  founded?: boolean;
}

const { fortunes, editable = false, founded = true } = Astro.props;
const fortuneOrder = ['vitality', 'cohesion', 'surplus', 'standing', 'tradition'] as const;
const allSteady = fortuneOrder.every((k) => Math.min(3, Math.max(0, fortunes[k] ?? 0)) === 2);
---

<section
  class="hall__sky"
  aria-labelledby="f-h"
  data-editable={editable ? 'true' : undefined}
  data-founded={founded ? 'true' : undefined}
>
  <div class="section-head">
    <h2 id="f-h">Fortunes</h2>
    <button
      type="button"
      class="info"
      data-tip="Community-wide pressure — not a second character sheet. Weather, not a ledger."
      aria-label="About Fortunes"
    >
      i
    </button>
  </div>
  {
    editable && (
      <p class="fortune-founding__kicker">
        {founded
          ? 'Revise this people’s weather — stored from this desk, not the hall.'
          : 'Starting impressions — not yet this community’s weather.'}
      </p>
    )
  }
  <div
    class="fortune-hall"
    role={editable ? 'group' : 'list'}
    aria-label={editable ? (founded ? 'Fortunes' : 'Starting Fortunes') : undefined}
  >
    {
      fortuneOrder.map((k) => {
        const v = Math.min(3, Math.max(0, fortunes[k] ?? 0));
        const label = FORTUNE_LABELS[v] ?? '';
        return (
          <div
            class:list={['kod-plate', 'fortune', editable && 'fortune--editable']}
            data-key={k}
            data-level={String(v)}
            role={editable ? 'slider' : 'listitem'}
            tabindex={editable ? 0 : undefined}
            aria-orientation={editable ? 'vertical' : undefined}
            aria-valuemin={editable ? 0 : undefined}
            aria-valuemax={editable ? 3 : undefined}
            aria-valuenow={editable ? v : undefined}
            aria-valuetext={editable ? label : undefined}
            aria-label={`${k}, ${label}`}
          >
            <span class="fortune__icon" aria-hidden="true" />
            <span class="fortune__name">{k}</span>
            <div class="fortune__well" aria-hidden="true">
              <i />
              <i />
              <i />
              <i />
            </div>
            <span class="fortune__state">{label}</span>
            <details class="fortune__blurb">
              <summary>What this measures</summary>
              <p>{FORTUNE_BLURBS[k] ?? ''}</p>
            </details>
          </div>
        );
      })
    }
  </div>
  {
    editable && (
      <div class="fortune-founding__commit">
        <button
          type="button"
          class="kod-btn kod-btn--folio fortune-founding__store"
          data-founding-store
          disabled={!founded && !allSteady}
        >
          {founded ? 'Store Fortunes' : 'Store starting Fortunes'}
        </button>
        <p class="fortune-founding__msg" data-founding-msg hidden></p>
      </div>
    )
  }
</section>
