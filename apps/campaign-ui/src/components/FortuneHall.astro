---
import { FORTUNE_LABELS } from '../data/load';
import { FORTUNE_BLURBS } from '../lib/format';

interface Props {
  fortunes: Record<string, number>;
  /** Live store and not yet founded — sky is the starting-weather board. */
  founding?: boolean;
}

const { fortunes, founding = false } = Astro.props;
const fortuneOrder = ['vitality', 'cohesion', 'surplus', 'standing', 'tradition'] as const;
const allSteady = fortuneOrder.every((k) => Math.min(3, Math.max(0, fortunes[k] ?? 0)) === 2);
---

<section class="hall__sky" aria-labelledby="f-h" data-founding={founding ? 'true' : undefined}>
  <div class="section-head">
    <h2 id="f-h">Fortunes</h2>
    <button
      type="button"
      class="info"
      data-tip="Community-wide pressure — not a second character sheet. Soft scale: Crisis 0 → Abundance 3."
      aria-label="About Fortunes"
    >
      i
    </button>
  </div>
  {
    founding && (
      <p class="fortune-founding__kicker">
        Starting impressions — not yet this community’s weather.
      </p>
    )
  }
  <div class="fortune-hall" role={founding ? 'group' : 'list'} aria-label={founding ? 'Starting Fortunes' : undefined}>
    {
      fortuneOrder.map((k) => {
        const v = Math.min(3, Math.max(0, fortunes[k] ?? 0));
        const label = FORTUNE_LABELS[v] ?? '';
        const crisis = v === 0;
        return (
          <div
            class:list={['kod-plate', 'fortune', founding && 'fortune--founding']}
            data-key={k}
            data-level={String(v)}
            role={founding ? 'slider' : 'listitem'}
            tabindex={founding ? 0 : undefined}
            aria-orientation={founding ? 'vertical' : undefined}
            aria-valuemin={founding ? 0 : undefined}
            aria-valuemax={founding ? 3 : undefined}
            aria-valuenow={founding ? v : undefined}
            aria-valuetext={founding ? label : undefined}
            aria-label={`${k}, ${label}`}
          >
            <span class="fortune__icon" aria-hidden="true" />
            <span class="fortune__name">{k}</span>
            <div class="fortune__well" aria-hidden="true">
              <span class="fortune__fill" />
              {crisis && <span class="fortune__ember" />}
            </div>
            <span class="fortune__state">{label}</span>
            {
              founding ? (
                <p class="fortune__purpose">{FORTUNE_BLURBS[k] ?? ''}</p>
              ) : (
                <details class="fortune__blurb">
                  <summary aria-label={k}>
                    <span class="fortune__blurb-mark" aria-hidden="true">◆</span>
                  </summary>
                  <p>{FORTUNE_BLURBS[k] ?? ''}</p>
                </details>
              )
            }
          </div>
        );
      })
    }
  </div>
  {
    founding && (
      <div class="fortune-founding__commit">
        <button
          type="button"
          class="kod-btn kod-btn--folio fortune-founding__store"
          data-founding-store
          disabled={!allSteady}
        >
          Store starting Fortunes
        </button>
        <p class="fortune-founding__msg" data-founding-msg hidden></p>
      </div>
    )
  }
</section>
