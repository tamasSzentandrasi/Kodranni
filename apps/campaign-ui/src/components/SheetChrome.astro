---
import { avatarUrl, monogram } from '../lib/format';

interface Props {
  slug: string;
  name: string;
  playerDisplay?: string;
  playerPlatform?: string;
  avatar?: string;
  status: string;
  dying?: boolean;
  decadence?: boolean;
  overCapacity?: boolean;
  live?: boolean;
  tab: 'core' | 'echoes' | 'inventory' | 'draft';
  showDraftTab?: boolean;
  /** Show portrait upload control in the identity block. */
  canEdit?: boolean;
  /** Storyteller desk. Field writes do not spend creation points. */
  desk?: boolean;
  concept?: string;
  communityTie?: string;
  whoWeSee?: string;
}

const {
  slug,
  name,
  playerDisplay,
  playerPlatform,
  avatar,
  status,
  dying,
  decadence,
  overCapacity,
  live,
  tab,
  showDraftTab = false,
  canEdit = false,
  desk = false,
  concept = '',
  communityTie = '',
  whoWeSee = '',
} = Astro.props;
const av = avatarUrl(slug, avatar);
const statusLabel = status === 'pending_review' ? 'pending review' : status;
const showPortraitEdit = Boolean(live && (canEdit || desk) && (tab === 'core' || tab === 'draft'));
const campaignQ = Astro.url.searchParams.get('campaign');
const tabQ = campaignQ ? `?campaign=${encodeURIComponent(campaignQ)}` : '';
const mapHref = campaignQ
  ? `/character-map/?person=${encodeURIComponent(slug)}&campaign=${encodeURIComponent(campaignQ)}`
  : `/character-map/?person=${encodeURIComponent(slug)}`;
---

<script is:inline>
  (function () {
    const u = new URL(location.href);
    const q = u.searchParams.get('edit');
    if (!q) return;
    document.cookie =
      'kod_edit=' + encodeURIComponent(q) + '; Path=/; Max-Age=86400; SameSite=Lax';
    u.searchParams.delete('edit');
    history.replaceState({}, '', u.pathname + u.search + u.hash);
  })();
</script>

<nav class="sheet-tabs" aria-label="Sheet sections">
  <a href={`/characters/${slug}/${tabQ}`} aria-current={tab === 'core' ? 'page' : undefined}>Core</a>
  <a
    href={`/characters/${slug}/echoes/${tabQ}`}
    aria-current={tab === 'echoes' ? 'page' : undefined}
  >
    Echoes · Traits
  </a>
  <a
    href={`/characters/${slug}/inventory/${tabQ}`}
    aria-current={tab === 'inventory' ? 'page' : undefined}
  >
    Inventory
  </a>
  {
    showDraftTab && tab === 'draft' && (
      <a
        href={`/characters/${slug}/draft/${tabQ}`}
        aria-current="page"
      >
        Who do we see?
      </a>
    )
  }
</nav>

<div
  class:list={['sheet-stage', tab === 'core' && 'sheet-stage--core']}
  data-desk-sheet={desk ? slug : undefined}
>
  <div class="kod-plate sheet-identity">
    <div class="sheet-identity__portrait">
      {
        av ? (
          <img class="avatar avatar--lg" src={av} alt="" width="84" height="84" />
        ) : (
          <span class="avatar avatar--lg avatar--mono" aria-hidden="true">
            {monogram(name)}
          </span>
        )
      }
      {
        showPortraitEdit && (
          <form
            class="avatar-upload"
            method="post"
            enctype="multipart/form-data"
            action={`/api/avatar/${slug}`}
            data-desk-portrait={desk ? '1' : undefined}
          >
            <label class="avatar-upload__btn">
              Change
              <input
                type="file"
                name="file"
                accept="image/jpeg,image/png,image/webp,image/gif"
                required
                hidden
              />
            </label>
          </form>
        )
      }
    </div>
    <div class="sheet-identity__text">
      <h1 class="sheet-identity__name">
        {
          desk ? (
            <label class="sheet-identity__name-edit">
              <input
                class="sheet-identity__name-input"
                data-desk-field="name"
                value={name}
                aria-label="Character name"
              />
            </label>
          ) : canEdit ? (
            <label class="sheet-identity__name-edit">
              <input
                class="sheet-identity__name-input"
                data-field="name"
                value={name}
                aria-label="Character name"
              />
              <span class="sheet-identity__pen" aria-hidden="true">✎</span>
            </label>
          ) : (
            <span>{name}</span>
          )
        }
        <a
          class="cmap-mark"
          href={mapHref}
          aria-label={`View ${name} on the character map`}
          data-tip={`View ${name} on the character map`}
        >
          <img src="/ornament/cmap-mark.jpg" alt="" width="48" height="48" />
        </a>
      </h1>
      <p class="sheet-identity__player">
        {
          playerDisplay ? (
            <>
              played by <strong>{playerDisplay}</strong>
              {playerPlatform ? ` · ${playerPlatform}` : ''}
            </>
          ) : (
            <span class="empty">No player mapped</span>
          )
        }
      </p>
      <p class="sheet-identity__chips">
        <span class="char-card__status" data-status={status}>
          {statusLabel}
        </span>
        {dying && <span class="flag">Dying</span>}
        {
          desk && status !== 'dead' && (
            <button
              type="button"
              class="desk-mark"
              data-desk-dead
              data-slug={slug}
              aria-label="Mark dead"
              data-tip="Mark dead"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M8 12h8" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </button>
          )
        }
        {
          desk && (
            <button
              type="button"
              class="desk-mark"
              data-desk-remove
              data-slug={slug}
              data-name={name}
              aria-label="Remove"
              data-tip="Remove"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </button>
          )
        }
        {
          decadence && (
            <span class="flag" data-tip="No active Echoes — −1 die on every roll">
              Decadence
            </span>
          )
        }
        {
          overCapacity && (
            <span class="flag" data-tip="−1 die only on rolls that involve an Echo">
              Over capacity
            </span>
          )
        }
      </p>
    </div>
    {
      (desk || canEdit || whoWeSee || concept || communityTie) && (
        <div class="sheet-identity__who">
          {
            desk ? (
              <>
                <label>
                  Concept
                  <input class="kod-ink" data-desk-field="concept" value={concept} />
                </label>
                <label>
                  Community tie
                  <input class="kod-ink" data-desk-field="communityTie" value={communityTie} />
                </label>
                <p class="sheet-identity__who-lab">Who do we see?</p>
                <textarea
                  class="sheet-identity__who-input"
                  data-desk-field="whoWeSee"
                  rows="3"
                  placeholder="The figure the table will recognise…"
                >{whoWeSee}</textarea>
              </>
            ) : canEdit ? (
              <>
                <p class="sheet-identity__who-lab">Who do we see?</p>
                <textarea
                  class="sheet-identity__who-input"
                  data-field="whoWeSee"
                  rows="3"
                  placeholder="The figure the table will recognise…"
                >{whoWeSee}</textarea>
              </>
            ) : (
              whoWeSee && (
                <>
                  <p class="sheet-identity__who-lab">Who do we see?</p>
                  <p class="sheet-identity__who-text">{whoWeSee}</p>
                </>
              )
            )
          }
        </div>
      )
    }
  </div>

  {/* In-flow after identity, out of .core-grid — PR 8 can `position: static` the budget here. */}
  <slot />
  {tab === 'core' && <slot name="stage" />}
</div>

{
  showPortraitEdit && (
    <script is:inline>
      (function () {
        const form = document.querySelector('.avatar-upload');
        if (!form) return;
        const input = form.querySelector('input[type="file"]');
        if (!input) return;
        input.addEventListener('change', async () => {
          if (!input.files || !input.files[0]) return;
          const fd = new FormData();
          fd.append('file', input.files[0], input.files[0].name);
          const headers = {};
          const deskPortrait = form.hasAttribute('data-desk-portrait');
          const m = document.cookie.match(/(?:^|;\s*)kod_edit=([^;]+)/);
          if (m) headers.Authorization = 'Bearer ' + decodeURIComponent(m[1]);
          else if (!deskPortrait && !location.search.includes('edit=')) {
            alert('Edit link required — open the sheet from the table bot (/create or review).');
            return;
          }
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: fd,
              headers,
              credentials: 'same-origin',
            });
            const j = await res.json().catch(() => ({}));
            if (res.ok) {
              const frame = form.closest('.sheet-identity__portrait');
              const bust = (j.url || form.action) + '?v=' + Date.now().toString(36);
              let img = frame && frame.querySelector('img.avatar');
              if (!img && frame) {
                const mono = frame.querySelector('.avatar--mono');
                if (mono) mono.remove();
                img = document.createElement('img');
                img.className = 'avatar avatar--lg';
                img.width = 84;
                img.height = 84;
                img.alt = '';
                frame.insertBefore(img, form);
              }
              if (img) img.src = bust;
              input.value = '';
            } else alert(j.error || j.hint || 'Upload failed (' + res.status + ')');
          } catch (e) {
            alert(e instanceof Error ? e.message : 'Upload failed');
          }
        });
      })();
    </script>
  )
}
