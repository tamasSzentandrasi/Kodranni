---
import { HIERARCHY_TIERS } from '@kodranni/domain';
import { axisDomain, axisKey } from '../lib/format';
import { inspectId } from '../lib/hall-inspect';
import type { FixtureCommunity } from '../data/fixture';

interface Props {
  axes: string[];
  ruler: string | null;
  rulerCharacterSlug?: string;
  placements: FixtureCommunity['placements'];
  pendingMoves?: FixtureCommunity['pendingMoves'];
  tips: Map<string, string>;
  live?: boolean;
  pcSlugs?: string[];
}

const {
  axes,
  ruler,
  rulerCharacterSlug,
  placements,
  pendingMoves = [],
  tips,
  live = false,
  pcSlugs = [],
} = Astro.props;
const tiers = [...HIERARCHY_TIERS];
const pcSet = new Set(pcSlugs);

function isPc(slug?: string): boolean {
  return Boolean(slug && pcSet.has(slug));
}

function tipFor(name: string, slug?: string, placementNote?: string): string {
  if (placementNote) return placementNote;
  if (slug && tips.has(slug)) return tips.get(slug)!;
  return tips.get(name.toLowerCase()) ?? '';
}

function personKey(name: string, slug?: string): string {
  return (slug ?? name).toLowerCase();
}

const rulerId = ruler ? inspectId(ruler, rulerCharacterSlug) : '';
---

<section class="hall__crown" aria-labelledby="h-h">
  <div class="section-head">
    <h2 id="h-h">Hierarchy</h2>
    <button
      type="button"
      class="info"
      data-tip="One crown, then parallel ladders. Same four tiers on every axis (Honoured → Outcast). Colour marks the axis; saturation falls toward Outcast. Hover names for who they are; click to inspect."
      aria-label="About Hierarchy"
    >
      i
    </button>
  </div>

  <div class="kod-plate hier-ruler">
    <p class="hier-ruler__title">Ruler</p>
    {
      ruler ? (
        <span
          class:list={['member', isPc(rulerCharacterSlug) && 'member--pc']}
          data-inspect-id={rulerId}
          data-name={ruler}
          data-kind={isPc(rulerCharacterSlug) ? 'pc' : 'npc'}
          data-tip={tipFor(ruler, rulerCharacterSlug)}
          role="button"
          tabindex="0"
          style="display:inline-flex;margin:0.35rem auto 0"
        >
          <span class="member__dot" />
          {ruler}
        </span>
      ) : (
        <p class="hier-ruler__note">One seat for the whole community — none claimed.</p>
      )
    }
  </div>
  <p class="hier-join" aria-hidden="true" />
</section>

<div class="hall__nave" role="region" aria-label="Hierarchy ladders">
  <div class="hier-axes">
    {
      axes.map((axis, ai) => {
        const onAxis = placements.filter((p) => p.axis === axis);
        const pendingOnAxis = pendingMoves.filter((m) => m.axis === axis);
        const key = axisKey(axis, ai);
        return (
          <div class="kod-plate hier-axis" data-axis={key} data-axis-name={axis}>
            <div class="hier-axis__head" tabindex={ai === 0 ? 0 : -1}>
              <p class="hier-axis__name">{axis}</p>
              <p class="hier-axis__domain">{axisDomain(axis)}</p>
              <span class="hier-axis__count">{onAxis.length} placed</span>
            </div>
            <ol class="hier-rungs">
              {tiers.map((tier) => {
                const members = onAxis.filter((p) => p.tier === tier);
                const destPending = pendingOnAxis.filter((m) => m.toTier === tier);
                const memberKeys = new Set(members.map((m) => personKey(m.name, m.characterSlug)));
                const extraPending = destPending.filter(
                  (m) => !memberKeys.has(personKey(m.name, m.characterSlug)),
                );
                const hasPending = destPending.length > 0;
                const empty = members.length === 0 && extraPending.length === 0;
                const defaultCollapsed =
                  hasPending ? false : empty || (tier === 'Outcast' && members.length > 5);
                return (
                  <li
                    class="hier-rung"
                    data-tier={tier}
                    data-collapsed={defaultCollapsed ? 'true' : 'false'}
                    data-pending={hasPending ? 'true' : undefined}
                  >
                    <button
                      type="button"
                      class="hier-rung__head"
                      data-rung-toggle
                      tabindex="-1"
                      aria-expanded={defaultCollapsed ? 'false' : 'true'}
                    >
                      <span class="hier-rung__tier">{tier}</span>
                      <span class="hier-rung__n">{members.length + extraPending.length}</span>
                      <span class="hier-rung__chev" aria-hidden="true">
                        {defaultCollapsed ? '▸' : '▾'}
                      </span>
                    </button>
                    <ul class="hier-rung__members">
                      {empty ? (
                        <li class="empty">—</li>
                      ) : (
                        <>
                          {members.map((m) => {
                            const tip = tipFor(m.name, m.characterSlug, m.note);
                            const pendingHere = destPending.some(
                              (p) => personKey(p.name, p.characterSlug) === personKey(m.name, m.characterSlug),
                            );
                            return (
                              <li>
                                <span
                                  class:list={[
                                    'member',
                                    isPc(m.characterSlug) && 'member--pc',
                                    pendingHere && 'member--pending',
                                  ]}
                                  data-inspect-id={inspectId(m.name, m.characterSlug)}
                                  data-name={m.name}
                                  data-kind={isPc(m.characterSlug) ? 'pc' : 'npc'}
                                  data-tip={tip}
                                  role="button"
                                  tabindex="-1"
                                >
                                  {pendingHere && (
                                    <span class="member__knot" aria-hidden="true">
                                      ◆
                                    </span>
                                  )}
                                  <span class="member__dot" />
                                  {m.name}
                                  {pendingHere && <span class="member__pending">pending</span>}
                                </span>
                              </li>
                            );
                          })}
                          {extraPending.map((m) => {
                            const tip = tipFor(m.name, m.characterSlug, m.note);
                            return (
                              <li>
                                <span
                                  class:list={[
                                    'member',
                                    'member--pending',
                                    isPc(m.characterSlug) && 'member--pc',
                                  ]}
                                  data-inspect-id={inspectId(m.name, m.characterSlug)}
                                  data-name={m.name}
                                  data-kind={isPc(m.characterSlug) ? 'pc' : 'npc'}
                                  data-tip={tip}
                                  role="button"
                                  tabindex="-1"
                                >
                                  <span class="member__knot" aria-hidden="true">
                                    ◆
                                  </span>
                                  <span class="member__dot" />
                                  {m.name}
                                  <span class="member__pending">pending</span>
                                </span>
                              </li>
                            );
                          })}
                        </>
                      )}
                    </ul>
                  </li>
                );
              })}
            </ol>
          </div>
        );
      })
    }
  </div>
  {
    live && (
      <div class="hier-add">
        <button type="button" class="kod-plus" data-rite-open="figure" aria-label="Add a name to the hall">
          <span class="kod-plus__ring" aria-hidden="true" />
          <span class="kod-plus__mark" aria-hidden="true">
            +
          </span>
        </button>
      </div>
    )
  }
</div>
