---
import { toRoman } from '../lib/format';

interface Props {
  rating: number;
  p: number;
}

const { rating, p } = Astro.props;
---

<span class="skill__ring" style={`--p: ${p}`}>
  <svg class="skill__dial" viewBox="0 0 40 40" aria-hidden="true">
    <circle class="skill__track" cx="20" cy="20" r="16.5" pathLength="100"></circle>
    <circle class="skill__arc-glow" cx="20" cy="20" r="16.5" pathLength="100"></circle>
    <circle class="skill__arc" cx="20" cy="20" r="16.5" pathLength="100"></circle>
  </svg>
  <span class="skill__inner">{toRoman(rating)}</span>
</span>
