        <circle cx="28.85" cy="35.15" r="0.55"></circle>
        <circle cx="27.55" cy="32" r="0.55"></circle>
        <circle cx="28.85" cy="28.85" r="0.55"></circle>
      </g>
    </g>
    <g class="skill-seal__rim" fill="#d0cac0" fill-rule="evenodd">
      <path d="M32 1.1a30.9 30.9 0 1 0 .002 0zm0 6.7a24.2 24.2 0 1 0 .002 0z"></path>
    </g>
  </svg>
  <span class="skill-seal__fill" aria-hidden="true"></span>
  <span class="skill-seal__n">{rating}</span>
</span>
