---
interface Props {
  axes: string[];
  tiers: string[];
  factions?: { name: string; hue: number }[];
}

const { axes, tiers, factions = [] } = Astro.props;
---

<button
  type="button"
  class="hall-dock-toggle"
  data-hall-search-toggle
  aria-expanded="true"
  aria-controls="kod-hall-search"
>
  Find
</button>
<aside
  class="kod-plate hall-search"
  id="kod-hall-search"
  data-hall-search
  aria-label="Find someone in the hall"
>
  <header class="hall-search__head">
    <div>
      <p class="hall-search__kicker">Hall</p>
      <h2 class="hall-search__title">Find</h2>
    </div>
    <button type="button" class="hall-search__hide" data-hall-search-toggle>
      Hide
    </button>
  </header>

  <div class="hall-search__lookup">
    <label class="hall-search__label" for="kod-hall-q">Name</label>
    <input
      id="kod-hall-q"
      class="hall-search__q"
      type="search"
      name="hall-q"
      autocomplete="off"
      placeholder="Optional — filters still list"
      data-hall-q
    />
    <button type="button" class="hall-search__clear" data-hall-clear aria-label="Clear search">
      Clear
    </button>
  </div>

  <div class="hall-search__filters" data-hall-filters>
    <div class="hall-search__group" role="group" aria-label="Axis">
      <p class="hall-search__legend">Axis</p>
      {axes.map((axis) => (
        <button type="button" class="hall-search__chip" data-filter="axis" data-value={axis} aria-pressed="false">
          {axis}
        </button>
      ))}
    </div>
    <div class="hall-search__group" role="group" aria-label="Standing">
      <p class="hall-search__legend">Standing</p>
      {tiers.map((tier) => (
        <button type="button" class="hall-search__chip" data-filter="tier" data-value={tier} aria-pressed="false">
          {tier}
        </button>
      ))}
    </div>
    <div class="hall-search__group" role="group" aria-label="Kind">
      <p class="hall-search__legend">Kind</p>
      <button type="button" class="hall-search__chip" data-filter="kind" data-value="pc" aria-pressed="false">
        Player
      </button>
      <button type="button" class="hall-search__chip" data-filter="kind" data-value="npc" aria-pressed="false">
        NPC
      </button>
    </div>
    <div class="hall-search__group" role="group" aria-label="Faction">
      <p class="hall-search__legend">Factions</p>
      {factions.length === 0 ? (
        <p class="hall-search__empty">None listed yet.</p>
      ) : (
        factions.map((f) => (
          <button
            type="button"
            class="hall-search__chip hall-search__chip--faction"
            data-filter="faction"
            data-value={f.name}
            aria-pressed="false"
            style={`--faction-h: ${f.hue}`}
          >
            {f.name}
          </button>
        ))
      )}
    </div>
  </div>

  <ul class="hall-search__hits" data-hall-hits hidden></ul>
</aside>
