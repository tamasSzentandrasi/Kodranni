---
import { FOUNDATION_GROUPS } from '@kodranni/domain';
import type { FixtureCharacter } from '../data/fixture';

interface Props {
  character: FixtureCharacter;
  live: boolean;
  canEdit?: boolean;
}

const { character: ch, live, canEdit = false } = Astro.props;
const creation = ch.creation;
const unlocked = canEdit && live && creation && !creation.locked;
const foundations = Object.values(FOUNDATION_GROUPS).flat();
---

{
  unlocked && (
    <>
    <div class="wanting-scrim" id="wanting-scrim" data-wanting-cancel aria-hidden="true"></div>
    <aside
      class="kod-plate wanting-panel"
      id="wanting-panel"
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="wanting-panel-title"
      data-slug={ch.slug}
    >
      <header class="wanting-panel__head">
        <div>
          <p class="wanting-panel__kicker">The Wanting</p>
          <h2 class="wanting-panel__title" id="wanting-panel-title">Spend Words</h2>
        </div>
        <button type="button" class="wanting-panel__close" data-wanting-close aria-label="Close">
          ×
        </button>
      </header>

      <p class="wanting-panel__lead">
        While open, normal Found/Skill spends are locked. Pick Foundations and mark skill ranks on
        <strong>Core</strong> (left-click mark · right-click unmark). Trait vs skill pay is exclusive.
        Each line must be <strong>Stage</strong>d before <strong>Confirm Wanting</strong>.
      </p>

      <p class="wanting-panel__words">
        Words: <strong data-field="words-open">{creation?.words ?? 0}</strong>
        · staged: <strong data-field="words-staged">0</strong>
      </p>

      <div class="wanting-menu" role="list">
        <button type="button" class="kod-plate wanting-menu__item" data-wanting-menu="plus_one_foundation">
          <span class="wanting-menu__buy">+1 to one Foundation</span>
          <span class="wanting-menu__cost">Pay: remove 3 skill ranks</span>
        </button>
        <button type="button" class="kod-plate wanting-menu__item" data-wanting-menu="plus_two_foundation_split">
          <span class="wanting-menu__buy">+2 Foundation points (split)</span>
          <span class="wanting-menu__cost">Two different Founds · pay 5 skill ranks or a Negative Trait</span>
        </button>
        <button type="button" class="kod-plate wanting-menu__item" data-wanting-menu="plus_five_skill">
          <span class="wanting-menu__buy">+5 skill points</span>
          <span class="wanting-menu__cost">Pay: −1 from one Foundation</span>
        </button>
        <button type="button" class="kod-plate wanting-menu__item" data-wanting-menu="positive_trait">
          <span class="wanting-menu__buy">One Positive Trait</span>
          <span class="wanting-menu__cost">Pay: remove 3 skill ranks</span>
        </button>
      </div>

      <form class="wanting-form" id="wanting-form" hidden>
        <p class="wanting-form__title" data-wanting-form-title></p>
        <div class="wanting-form__fields" data-wanting-form-fields></div>
        <div class="wanting-form__actions">
          <button type="submit" class="kod-btn">Stage this Word</button>
          <button type="button" class="kod-btn" data-wanting-form-cancel>Back</button>
        </div>
      </form>

      <section class="wanting-staged">
        <h3>Staged</h3>
        <ul class="wanting-staged__list" data-wanting-staged></ul>
        <p class="wanting-staged__empty" data-wanting-empty>Nothing staged yet.</p>
      </section>

      <div class="wanting-panel__footer">
        <button type="button" class="kod-plate wanting-confirm" data-wanting-confirm>
          Confirm Wanting
        </button>
        <button type="button" class="kod-btn" data-wanting-cancel>
          Cancel · discard
        </button>
      </div>
      <p class="wanting-panel__msg" data-msg="wanting" hidden></p>

      <template id="wanting-field-catalog" hidden>
        <select data-foundations>
          {foundations.map((f) => <option value={f}>{f}</option>)}
        </select>
      </template>
    </aside>
    </>
  )
}
