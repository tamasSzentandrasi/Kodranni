---
import type { FixtureCharacter } from '../data/fixture';

interface Props {
  character: FixtureCharacter;
  live: boolean;
}

const { character: ch, live } = Astro.props;
const creation = ch.creation;
const unlocked = live && creation && !creation.locked;
---

{
  unlocked && creation && (
    <section
      class="kod-plate draft-panel"
      id="draft-panel"
      data-slug={ch.slug}
      data-foundation-points={String(creation.foundationPoints)}
      data-skill-points={String(creation.skillPoints)}
      data-words={String(creation.words)}
    >
      <div class="section-head">
        <h2>Concept</h2>
        <button
          type="button"
          class="info"
          data-tip="Private prep stays on this tab. Raise Foundations and Skills on Core; Confirm is on Core as well."
          aria-label="About draft concept"
        >
          i
        </button>
      </div>

      <div class="draft-concept">
        <label class="draft-label">
          Name
          <input
            class="kod-ink"
            type="text"
            name="name"
            value={ch.name}
            data-field="name"
            placeholder="Character name…"
          />
        </label>
        <label class="draft-label">
          Concept
          <textarea
            class="kod-ink"
            name="concept"
            rows="4"
            data-field="concept"
            placeholder="What drives this person…"
          >{ch.concept ?? ''}</textarea>
        </label>
        <label class="draft-label">
          Community tie
          <textarea
            class="kod-ink"
            name="communityTie"
            rows="3"
            data-field="communityTie"
            placeholder="How they bind to the table’s place…"
          >{ch.communityTie}</textarea>
        </label>
        <label class="draft-label">
          Who do we see?
          <textarea
            class="kod-ink"
            name="whoWeSee"
            rows="3"
            data-field="whoWeSee"
            placeholder="Ink the figure the table will recognise…"
          >{ch.whoWeSee ?? ''}</textarea>
        </label>
        <button type="button" class="kod-btn" data-action="save-concept">
          Save concept
        </button>
        <p class="draft-msg" data-msg="concept" hidden></p>
      </div>

      <p class="draft-hint">
        Spend and Confirm live on <a href={`/characters/${ch.slug}/`}>Core</a>. Portrait sits with
        the name above.
      </p>
    </section>
  )
}

{
  unlocked && <script is:inline src="/creation-client.js"></script>
}

<style>
  .draft-panel {
    margin: 1.25rem auto 2rem;
    max-width: 36rem;
  }
  .draft-concept {
    display: grid;
    gap: 0.75rem;
  }
  .draft-label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--kod-silver, #b8b3ab);
  }
  .draft-panel .kod-btn {
    width: auto;
    min-width: 0;
    max-width: none;
    height: auto;
    min-height: 2.55rem;
    max-height: none;
    padding: 0.45rem 1.15rem;
    justify-self: start;
  }
</style>
