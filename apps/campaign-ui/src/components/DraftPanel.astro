---
import type { FixtureCharacter } from '../data/fixture';

interface Props {
  character: FixtureCharacter;
  live: boolean;
}

const { character: ch, live } = Astro.props;
const creation = ch.creation;
const unlocked = live && creation && !creation.locked;
---

{
  unlocked && creation && (
    <section
      class="kod-plate draft-panel"
      id="draft-panel"
      data-slug={ch.slug}
      data-foundation-points={String(creation.foundationPoints)}
      data-skill-points={String(creation.skillPoints)}
      data-words={String(creation.words)}
    >
      <div class="section-head">
        <h2>Who do we see?</h2>
        <button
          type="button"
          class="info"
          data-tip="The figure the table will recognise. Concept and community tie stay spoken between you and the Storyteller."
          aria-label="About Who do we see?"
        >
          i
        </button>
      </div>

      <label class="draft-label">
        <span class="visually-hidden">Who do we see?</span>
        <textarea
          class="kod-ink draft-who__field"
          name="whoWeSee"
          rows="6"
          data-field="whoWeSee"
          placeholder="Ink the figure the table will recognise…"
        >{ch.whoWeSee ?? ''}</textarea>
      </label>
      <p class="draft-msg" data-msg="concept" hidden></p>
    </section>
  )
}

{
  unlocked && <script is:inline src="/creation-client.js"></script>
}

<style>
  .draft-panel {
    margin: 1.25rem auto 2rem;
    max-width: 36rem;
    padding: 1.05rem 1rem 1.15rem;
  }
  .draft-label {
    display: grid;
    gap: 0.25rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>
