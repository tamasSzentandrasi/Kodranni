---
import type { FixtureCharacter } from '../data/fixture';

interface Props {
  character: FixtureCharacter;
  live: boolean;
}

const { character: ch, live } = Astro.props;
const creation = ch.creation;
const unlocked = live && creation && !creation.locked;
---

{
  unlocked && creation && (
    <section
      class="kod-plate draft-panel"
      id="draft-panel"
      data-slug={ch.slug}
      data-foundation-points={String(creation.foundationPoints)}
      data-skill-points={String(creation.skillPoints)}
      data-words={String(creation.words)}
    >
      <div class="section-head">
        <h2>Concept</h2>
        <button
          type="button"
          class="info"
          data-tip="Private prep stays on this tab. Raise Foundations and Skills on Core; Confirm is on Core as well."
          aria-label="About draft concept"
        >
          i
        </button>
      </div>

      <div class="draft-concept">
        <label class="draft-label">
          Name
          <input type="text" name="name" value={ch.name} data-field="name" />
        </label>
        <label class="draft-label">
          Concept
          <textarea name="concept" rows="4" data-field="concept">{ch.concept ?? ''}</textarea>
        </label>
        <label class="draft-label">
          Community tie
          <textarea name="communityTie" rows="3" data-field="communityTie">{ch.communityTie}</textarea>
        </label>
        <label class="draft-label">
          Who do we see?
          <textarea name="whoWeSee" rows="3" data-field="whoWeSee">{ch.whoWeSee ?? ''}</textarea>
        </label>
        <button type="button" class="draft-btn" data-action="save-concept">
          Save concept
        </button>
        <p class="draft-msg" data-msg="concept" hidden></p>
      </div>

      <p class="draft-hint">
        When ready, return to <a href={`/characters/${ch.slug}/`}>Core</a> and use{' '}
        <strong>Confirm draft</strong> at the bottom.
      </p>
    </section>
  )
}

{
  unlocked && <script is:inline src="/creation-client.js"></script>
}

<style>
  .draft-panel {
    margin-bottom: 1.25rem;
  }
  .draft-concept {
    display: grid;
    gap: 0.55rem;
    margin: 0.35rem 0 0;
  }
  .draft-label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .draft-label input,
  .draft-label textarea {
    font: inherit;
    padding: 0.4rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--kod-silver, #b8b3ab) 28%, transparent);
    border-radius: 2px;
    background: color-mix(in srgb, #080606 92%, #fff 8%);
    color: inherit;
    width: 100%;
    max-width: 40rem;
  }
  .draft-btn {
    font: inherit;
    cursor: pointer;
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--kod-silver, #b8b3ab) 40%, transparent);
    background: transparent;
    color: inherit;
    border-radius: 2px;
    justify-self: start;
  }
  .draft-btn:hover:not(:disabled) {
    border-color: var(--kod-silver, #b8b3ab);
    background: color-mix(in srgb, var(--kod-silver, #b8b3ab) 12%, transparent);
  }
  .draft-hint {
    font-size: 0.9rem;
    opacity: 0.85;
    margin: 1rem 0 0;
  }
  .draft-hint a {
    color: var(--kod-silver-bright, #f2efe9);
  }
  .draft-msg {
    font-size: 0.9rem;
    margin: 0.35rem 0 0;
  }
  .draft-msg--err {
    color: var(--kod-blood, #c44);
  }
  .draft-msg--ok {
    opacity: 0.9;
  }
</style>
