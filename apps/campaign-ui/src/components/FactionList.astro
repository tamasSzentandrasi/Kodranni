---
import type { FactionOpt } from '../lib/format';

interface Props {
  factions?: FactionOpt[];
  live?: boolean;
}

const { factions = [], live = false } = Astro.props;
---

<aside class="kod-plate factions" aria-labelledby="fac-h">
  <div class="section-head" style="margin:0">
    <h3 id="fac-h">Factions</h3>
    <button
      type="button"
      class="info"
      data-tip="Banners outsiders may answer to. Colour is theirs. Find still filters the hall; this list is the record."
      aria-label="About Factions"
    >
      i
    </button>
  </div>
  <ul class="factions__list">
    {
      factions.length === 0 ? (
        <li class="empty">None listed yet.</li>
      ) : (
        factions.map((f) => (
          <li>
            <button
              type="button"
              class="faction-row"
              data-preview-faction={f.name}
              style={`--faction-h: ${f.hue}`}
            >
              <span class="faction-row__swatch" aria-hidden="true" />
              <span class="faction-row__name">{f.name}</span>
            </button>
          </li>
        ))
      )
    }
  </ul>
  {
    live && (
      <div class="factions__add">
        <button type="button" class="kod-plus kod-plus--sm" data-rite-open="faction" aria-label="Add a faction">
          <span class="kod-plus__ring" aria-hidden="true" />
          <span class="kod-plus__mark" aria-hidden="true">
            +
          </span>
        </button>
      </div>
    )
  }
</aside>
