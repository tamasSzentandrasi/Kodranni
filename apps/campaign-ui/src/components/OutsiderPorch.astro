---
import { resolveFactionHue, type FactionOpt } from '../lib/format';
import { inspectId } from '../lib/hall-inspect';
import type { FixtureCommunity } from '../data/fixture';

interface Props {
  outsiders: FixtureCommunity['outsiders'];
  factions?: FactionOpt[];
}

const { outsiders, factions = [] } = Astro.props;
const none = outsiders.length === 0;
---

<aside class="kod-plate outsiders" aria-labelledby="o-h">
  <div class="section-head" style="margin:0">
    <h3 id="o-h">Outsiders</h3>
    <button
      type="button"
      class="info"
      data-tip="Named individuals only. Faction is a coloured property. Not on any ladder until inducted. Click a name to inspect."
      aria-label="About Outsiders"
    >
      i
    </button>
  </div>
  <ul class="outsiders__list kod-scroll">
    {
      none ? (
        <li class="empty">None tracked.</li>
      ) : (
        outsiders.map((o) => {
          const hue = o.faction ? resolveFactionHue(o.faction, factions) : 0;
          return (
            <li
              class="outsider"
              style={o.faction ? `--faction-h: ${hue}` : undefined}
              data-inspect-id={inspectId(o.name, o.characterSlug)}
              data-name={o.name}
              data-kind="outsider"
              data-faction={o.faction ?? ''}
              data-tip={o.note ?? ''}
              role="button"
              tabindex="0"
            >
              <span class="outsider__name">{o.name}</span>
              {o.faction && <span class="outsider__faction">{o.faction}</span>}
            </li>
          );
        })
      )
    }
  </ul>
</aside>
