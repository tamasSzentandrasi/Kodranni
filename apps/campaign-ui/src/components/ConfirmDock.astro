---
import type { FixtureCharacter } from '../data/fixture';

interface Props {
  character: FixtureCharacter;
  live: boolean;
  canEdit?: boolean;
}

const { character: ch, live, canEdit = false } = Astro.props;
const creation = ch.creation;
const unlocked = canEdit && live && creation && !creation.locked;
const awaitingReview = unlocked && ch.status === 'pending_review';
const canConfirm =
  unlocked && ch.status === 'draft' && Boolean(ch.initiator?.accountId);
---

{
  unlocked && (
    <div class="kod-plate draft-foot" id="draft-confirm">
      <div class="draft-foot__ornament" aria-hidden="true">
        <span class="draft-foot__rule" />
        <span class="draft-foot__mark">᛫</span>
        <span class="draft-foot__rule" />
      </div>

      {
        awaitingReview ? (
          <div class="draft-foot__body">
            <p class="flag flag--ok">Submitted for approval</p>
            <p class="draft-hint">
              The Storyteller approves this sheet or sends it back. It stays open until then.
            </p>
          </div>
        ) : canConfirm ? (
          <div class="draft-foot__body">
            <button type="button" class="kod-btn kod-btn--folio kod-btn--blood" data-action="confirm">
              <span class="kod-btn__kicker">Return to table</span>
              <span class="kod-btn__title">Confirm draft</span>
            </button>
            <p class="draft-hint">
              Mentions <strong>{ch.initiator?.displayName ?? 'you'}</strong>. The Storyteller
              Approves or sends it back.
            </p>
            <p class="draft-msg" data-msg="confirm" hidden></p>
          </div>
        ) : !ch.initiator?.accountId ? (
          <div class="draft-foot__body">
            <p class="draft-hint">
              Start this character from the table bot (<code>/create</code>) so Confirm can mention
              you.
            </p>
          </div>
        ) : (
          <div class="draft-foot__body">
            <p class="draft-hint">
              Set Who do we see? on Core, then Confirm here.
            </p>
          </div>
        )
      }

      <div class="draft-foot__ornament" aria-hidden="true">
        <span class="draft-foot__rule" />
        <span class="draft-foot__mark">᛫</span>
        <span class="draft-foot__rule" />
      </div>
    </div>
  )
}
