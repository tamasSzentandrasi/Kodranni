---
import { PREP_FOUNDATION_POINTS, PREP_SKILL_POINTS } from '@kodranni/app';
import type { FixtureCharacter } from '../data/fixture';

interface Props {
  character: FixtureCharacter;
  live: boolean;
  canEdit?: boolean;
}

const { character: ch, live, canEdit = false } = Astro.props;
const creation = ch.creation;
const unlocked = canEdit && live && creation && !creation.locked;

function foundationInvested(foundations: Record<string, number>): number {
  let s = 0;
  for (const v of Object.values(foundations)) {
    if (v >= 2) s += 1;
    if (v >= 3) s += 2;
  }
  return s;
}

function skillInvested(
  skills: { rating: number }[],
): number {
  let s = 0;
  for (const sk of skills) {
    const r = sk.rating ?? 0;
    if (r >= 1) s += 1;
    if (r >= 2) s += 2;
    if (r >= 3) s += 3;
  }
  return s;
}

const fInvested = unlocked ? foundationInvested(ch.foundations) : 0;
const sInvested = unlocked ? skillInvested(ch.skills) : 0;
const fLeft = creation?.foundationPoints ?? 0;
const sLeft = creation?.skillPoints ?? 0;
const fPool = fInvested + fLeft;
const sPool = sInvested + sLeft;
const words = creation?.words ?? 0;
---

{
  unlocked && creation && (
    <aside
      class="kod-plate budget-dock"
      id="budget-dock"
      aria-label="Creation budgets"
      data-slug={ch.slug}
      data-foundation-points={String(creation.foundationPoints)}
      data-skill-points={String(creation.skillPoints)}
      data-words={String(creation.words)}
      data-prep-found={String(PREP_FOUNDATION_POINTS)}
      data-prep-skill={String(PREP_SKILL_POINTS)}
    >
      <header class="budget-dock__head">
        <p class="budget-dock__kicker">Creation</p>
        <h2 class="budget-dock__title">Budgets</h2>
      </header>

      <button type="button" class="kod-plate budget-card" data-jump="section-foundations" data-budget="foundation">
        <span class="budget-card__label">Foundations</span>
        <span class="budget-card__main">
          <strong data-field="foundationPoints">{fLeft}</strong>
          <span class="budget-card__unit">left</span>
        </span>
        <span class="budget-card__meta">
          <span><em data-field="foundationSpent">{fInvested}</em> spent</span>
          <span class="budget-card__pool">of <em data-field="foundationPool">{fPool}</em></span>
        </span>
        <span class="budget-card__bar" aria-hidden="true">
          <span
            class="budget-card__fill"
            data-field="foundationFill"
            style={`width: ${fPool > 0 ? Math.round((fInvested / fPool) * 100) : 0}%`}
          />
        </span>
        <span class="budget-card__cta">Jump to Foundations →</span>
      </button>

      <button type="button" class="kod-plate budget-card" data-jump="section-skills" data-budget="skill">
        <span class="budget-card__label">Skills</span>
        <span class="budget-card__main">
          <strong data-field="skillPoints">{sLeft}</strong>
          <span class="budget-card__unit">left</span>
        </span>
        <span class="budget-card__meta">
          <span><em data-field="skillSpent">{sInvested}</em> spent</span>
          <span class="budget-card__pool">of <em data-field="skillPool">{sPool}</em></span>
        </span>
        <span class="budget-card__bar" aria-hidden="true">
          <span
            class="budget-card__fill"
            data-field="skillFill"
            style={`width: ${sPool > 0 ? Math.round((sInvested / sPool) * 100) : 0}%`}
          />
        </span>
        <span class="budget-card__cta">Jump to Skills →</span>
      </button>

      <button type="button" class="kod-plate budget-card budget-card--words" data-open-wanting data-budget="words">
        <span class="budget-card__label">Words</span>
        <span class="budget-card__main">
          <strong data-field="words">{words}</strong>
          <span class="budget-card__unit">to Want</span>
        </span>
        <span class="budget-card__meta">
          Awarded at the table · spend in The Wanting
        </span>
        <span class="budget-card__cta">Open Wanting →</span>
      </button>

      <div class="budget-dock__flags">
        <span
          class:list={['flag', creation.birthOmenGranted && 'flag--ok']}
          data-field="birthOmenFlag"
        >
          {creation.birthOmenGranted ? 'Birth Omen ✓' : 'Birth Omen pending'}
        </span>
        <span
          class:list={['flag', creation.guidingHandGranted && 'flag--ok']}
          data-field="guidingHandFlag"
        >
          {creation.guidingHandGranted ? 'Guiding Hand ✓' : 'Guiding Hand pending'}
        </span>
      </div>

      <p class="budget-dock__hint">
        Tables: left-click raise · right-click refund
      </p>
      <p class="budget-dock__msg" data-msg="spend" hidden></p>
    </aside>
  )
}
