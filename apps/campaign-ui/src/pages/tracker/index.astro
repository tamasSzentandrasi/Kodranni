---
export const prerender = false;

import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { FORTUNE_LABELS } from '../../data/fixture';
import { loadCommunity } from '../../data/load';

const c = loadCommunity();
const navCharacters = c.characters.map((ch) => ({ slug: ch.slug, name: ch.name }));
const tiers = ['Honoured', 'Trusted', 'Acknowledged', 'Outcast'] as const;
---

<CampaignLayout
  title="Tracker"
  communityName={c.name}
  generatedAt={c.generatedAt}
  current="tracker"
  source={c.source}
  navCharacters={navCharacters}
>
  <section class="kod-panel">
    <h2>Fortunes</h2>
    <p class="kod-meta">Ambient community pressure for every scene.</p>
    <ul class="kod-stat-grid">
      {
        Object.entries(c.fortunes).map(([k, v]) => (
          <li class="kod-stat">
            <span class="kod-stat__label">{k}</span>
            <span class="kod-stat__value">{v}</span>
            <span class="kod-stat__value--muted">{FORTUNE_LABELS[v] ?? ''}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="kod-panel">
    <h2>Hierarchy Diagram</h2>
    <div class="kod-ruler">
      <span class="kod-ruler__title">Ruler</span>
      <span class="kod-stat__value--muted">{c.ruler ?? '— none claimed —'}</span>
    </div>
    <p class="kod-meta">One seat above every axis. Parallel ladders below.</p>
    <div class="kod-axes">
      {
        c.hierarchyAxes.map((axis) => {
          const onAxis = c.placements.filter((p) => p.axis === axis);
          return (
            <div class="kod-axis">
              <p class="kod-axis__name">{axis}</p>
              <ol class="kod-rungs">
                {tiers.map((tier) => {
                  const names = onAxis.filter((p) => p.tier === tier).map((p) => p.name);
                  return (
                    <li>
                      <span class="kod-rung__tier">{tier}</span>
                      <span class="kod-rung__names">
                        {names.length ? names.join(', ') : '—'}
                      </span>
                    </li>
                  );
                })}
              </ol>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="kod-panel">
    <h2>Foundation Myths</h2>
    {
      c.myths.length === 0 ? (
        <p class="kod-empty">None active.</p>
      ) : (
        c.myths.map((m) => (
          <div>
            <strong>{m.title}</strong>
            <p class="kod-meta">{m.summary}</p>
          </div>
        ))
      )
    }
  </section>
</CampaignLayout>

<style>
  .kod-ruler {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--kod-blood) 45%, #333);
    background: color-mix(in srgb, var(--kod-blood-deep) 28%, #0a0a0a);
  }
  .kod-ruler__title {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kod-blood-bright);
    font-size: 0.85rem;
  }
  .kod-axes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.85rem;
    margin-top: 1rem;
  }
  .kod-axis {
    border: 1px solid #2a2222;
    background: #0c0c0c;
    padding: 0.65rem 0.75rem 0.85rem;
  }
  .kod-axis__name {
    margin: 0 0 0.5rem;
    color: var(--kod-silver-bright);
    letter-spacing: 0.06em;
  }
  .kod-rungs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kod-rungs li {
    display: grid;
    gap: 0.1rem;
    padding: 0.35rem 0;
    border-top: 1px solid #1c1818;
    font-size: 0.95rem;
  }
  .kod-rung__tier {
    color: var(--kod-silver-dim);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .kod-rung__names {
    color: var(--kod-silver);
  }
</style>
