---
export const prerender = false;

import { mapChrome, mapInner } from '@kodranni/hall-render';
import { fillDemoRelationMap, openSqliteStore } from '@kodranni/store';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { loadCommunity } from '../../data/load';
import { resolveStorePath } from '../../lib/campaign-paths';

const c = loadCommunity();
const person = Astro.url.searchParams.get('person') ?? undefined;
let map = fillDemoRelationMap(undefined, c.slug);
const storePath = resolveStorePath();
if (storePath) {
  const store = openSqliteStore(storePath);
  try {
    map = fillDemoRelationMap(store.getRelationMap(), c.slug);
  } finally {
    store.close();
  }
}
const hallHtml =
  mapChrome({
    slug: c.slug,
    name: c.name,
    fortunes: c.fortunes,
    myths: c.myths,
    hierarchyAxes: c.hierarchyAxes,
    ruler: c.ruler,
    rulerCharacterSlug: c.rulerCharacterSlug,
    placements: c.placements,
    outsiders: c.outsiders ?? [],
    labelGroups: c.labelGroups ?? [],
    labels: c.labels ?? [],
    factions: c.factions ?? [],
  }) +
  mapInner(map, {
  person,
  meta: {
    campaign: c.name,
    groups: c.labelGroups ?? [],
    labels: c.labels ?? [],
    roster: c.characters.map((ch) => ({
      slug: ch.slug,
      labelIds: ch.labelIds ?? [],
    })),
  },
});
---

<CampaignLayout
  title="Character map"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="map"
  source={c.source}
>
  <Fragment set:html={hallHtml} />
  <script>
    import { bootMap } from '../../lib/character-map';
    bootMap();
  </script>
</CampaignLayout>
