---
export const prerender = false;

import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import CreationChrome from '../../../components/CreationChrome.astro';
import SheetChrome from '../../../components/SheetChrome.astro';
import { getCharacter, loadCommunity } from '../../../data/load';
import { WEIGHT_BAND } from '../../../lib/format';
import { deskToolsOn } from '../../../lib/loopback';
import { editCookieHeader, redirectSheetEdit, resolveSheetEdit } from '../../../lib/sheet-auth';

const { slug } = Astro.params;
const c = loadCommunity();
const ch = getCharacter(slug!);
if (!ch) {
  return new Response('Character not found', { status: 404, statusText: 'Not Found' });
}
const parkedEdit = redirectSheetEdit(Astro.url, ch.slug);
if (parkedEdit) return parkedEdit;

const live = c.source === 'live';
const unlocked = Boolean(live && ch.creation && !ch.creation.locked);
const auth = resolveSheetEdit(Astro.request, Astro.url, ch.slug);
if (auth.canEdit && auth.token) {
  Astro.response.headers.append('Set-Cookie', editCookieHeader(auth.token));
}
const canEdit = unlocked && auth.canEdit;
const desk = live && deskToolsOn(Astro.request);
const playerEdit = canEdit && !desk;
const sheetEdit = desk || canEdit;
const living = c.characters.filter((x) => x.status !== 'dead' && x.slug !== ch.slug);
const active = (ch.echoes ?? []).filter((e) => !e.resolved);
const resolved = (ch.echoes ?? []).filter((e) => e.resolved);
const sheetNames = new Set(c.characters.map((x) => x.name.toLowerCase()));
const echoRoster = [
  ...c.characters.map((x) => ({ name: x.name, slug: x.slug })),
  ...(c.outsiders ?? [])
    .filter((o) => !sheetNames.has(o.name.toLowerCase()))
    .map((o) => ({ name: o.name, slug: o.characterSlug })),
].sort((a, b) => a.name.localeCompare(b.name));
---

<CampaignLayout
  title={`${ch.name} · Echoes`}
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <SheetChrome
    slug={ch.slug}
    name={ch.name}
    playerDisplay={ch.player?.displayName}
    playerPlatform={ch.player?.platform}
    avatar={ch.avatar}
    status={ch.status}
    dying={ch.dying}
    decadence={ch.flags.decadence}
    overCapacity={ch.flags.overCapacity}
    live={live}
    tab="echoes"
    canEdit={canEdit && !desk}
    desk={desk}
    concept={ch.concept}
    communityTie={ch.communityTie}
    whoWeSee={ch.whoWeSee}
    claimable={Boolean(ch.creation?.claimable)}
  >
  <CreationChrome character={ch} live={live} canEdit={playerEdit} />

  <section
    class="kod-plate"
    id="echoes-panel"
    data-slug={ch.slug}
    data-can-edit={sheetEdit ? '1' : '0'}
    data-desk={desk ? '1' : '0'}
  >
    {sheetEdit && (
      <div id="echo-roster" hidden>
        {JSON.stringify(echoRoster).replace(/</g, '\\u003c')}
      </div>
    )}
    <div class="section-head">
      <h2>Active Echoes</h2>
      <button
        type="button"
        class="info"
        data-tip={
          desk
            ? 'Click a segment to set the weight. An empty plate writes the next Echo.'
            : 'Left column = weight (1–3). When editing: left-click weight to raise, right-click to lower.'
        }
        aria-label="About active Echoes"
      >
        i
      </button>
    </div>

    <div class="echo-list" data-echo-list>
      {
        active.length === 0 && !sheetEdit ? (
          <p class="empty">None active — Decadence if this stands (−1 die on every roll).</p>
        ) : (
          active.map((e, idx) => {
            const w = (e.weight === 2 || e.weight === 3 ? e.weight : 1) as 1 | 2 | 3;
            return (
              <article class="kod-plate echo" data-echo-idx={String(idx)}>
                <div
                  class:list={['echo__weight', sheetEdit && 'echo__weight--edit']}
                  data-echo-weight
                  data-weight={String(w)}
                  tabindex={sheetEdit ? 0 : undefined}
                  data-tip={
                    desk
                      ? 'Click a segment to set 1, 2, or 3'
                      : sheetEdit
                        ? 'Left-click +1 · right-click −1 (1–3)'
                        : undefined
                  }
                >
                  <span class="weight-segs" aria-label={`Weight ${w}`}>
                    {[1, 2, 3].map((i) => (
                      <i class={i <= w ? 'on' : ''} data-seg={desk ? String(i) : undefined} />
                    ))}
                  </span>
                  <span class="weight-band">{WEIGHT_BAND[w]}</span>
                </div>
                <div class="echo__body">
                  {
                    sheetEdit ? (
                      <>
                        <input
                          class="echo__title-input kod-ink"
                          data-echo-title
                          value={e.title}
                          placeholder="Echo title…"
                        />
                        <label class="echo__invoke-edit">
                          <span class="echo__invoke-lab">Invoke when</span>
                          <textarea
                            class="kod-ink"
                            data-echo-invoke
                            rows="2"
                            placeholder="When the table agrees the scene matches…"
                          >{e.invokeWhen ?? ''}</textarea>
                        </label>
                        <div class="echo__circle" data-echo-circle hidden={w !== 2}>
                          <p class="echo__circle-lab">Who shares this</p>
                          <ul class="echo__people" data-echo-group>
                            {(e.group ?? []).map((g) => (
                              <li data-slug={g.characterSlug || undefined}>
                                <span data-echo-group-name>{g.name}</span>
                                <button type="button" data-echo-group-remove>
                                  Remove
                                </button>
                              </li>
                            ))}
                          </ul>
                          <label class="echo__pick">
                            <span class="echo__pick-lab">Add a character</span>
                            <select class="kod-ink" data-echo-group-pick>
                              <option value="">Choose…</option>
                            </select>
                          </label>
                        </div>
                        <p class="echo__circle-all" data-echo-all hidden={w !== 3}>
                          The whole community.
                        </p>
                        <button type="button" class="echo__remove" data-echo-remove>
                          Remove
                        </button>
                        {
                          desk && (
                            <div class="echo__resolve" data-echo-resolve>
                              <label>
                                Resolution
                                <textarea class="kod-ink" data-echo-resolution rows="2"></textarea>
                              </label>
                              {
                                w === 3 && (
                                  <p>
                                    <label>
                                      Fortune
                                      <select data-echo-fortune>
                                        <option value="vitality">Vitality</option>
                                        <option value="cohesion">Cohesion</option>
                                        <option value="surplus">Surplus</option>
                                        <option value="standing">Standing</option>
                                        <option value="tradition">Tradition</option>
                                      </select>
                                    </label>
                                    <label>
                                      State
                                      <select data-echo-fortune-level>
                                        <option value="0">Crisis</option>
                                        <option value="1">Strained</option>
                                        <option value="2" selected>Steady</option>
                                        <option value="3">Abundance</option>
                                      </select>
                                    </label>
                                  </p>
                                )
                              }
                              <button type="button" data-echo-resolve-go>
                                Resolve
                              </button>
                            </div>
                          )
                        }
                      </>
                    ) : (
                      <>
                        <h3 class="echo__title">{e.title}</h3>
                        <div class="echo__invoke">
                          <span class="echo__invoke-lab">Invoke when</span>
                          {e.invokeWhen}
                        </div>
                        {
                          w === 2 && (
                            <div class="echo__circle">
                              <p class="echo__circle-lab">{e.groupLabel || 'Who shares this'}</p>
                              {(e.group ?? []).length === 0 ? (
                                <p class="empty">None named yet.</p>
                              ) : (
                                <ul class="echo__people">
                                  {(e.group ?? []).map((g) => (
                                    <li>
                                      {g.characterSlug ? (
                                        <a href={`/characters/${g.characterSlug}/`}>{g.name}</a>
                                      ) : (
                                        g.name
                                      )}
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </div>
                          )
                        }
                        {w === 3 && <p class="echo__circle-all">The whole community.</p>}
                      </>
                    )
                  }
                </div>
              </article>
            );
          })
        )
      }
    </div>
    {
      sheetEdit && !desk && (
        <button type="button" class="draft-btn" data-echo-add style="margin-top:0.75rem">
          + Add Echo
        </button>
      )
    }
    {
      desk && (
        <article class="kod-plate echo" data-echo-new>
          <input class="echo__title-input kod-ink" data-echo-title placeholder="Write an echo" />
          <label class="echo__invoke-edit">
            <span class="echo__invoke-lab">Invoke when</span>
            <textarea class="kod-ink" data-echo-invoke rows="2" placeholder="When the table agrees the scene matches…"></textarea>
          </label>
        </article>
      )
    }
  </section>

  {
    resolved.length > 0 && (
      <section class="kod-plate">
        <div class="section-head">
          <h2>Resolved</h2>
        </div>
        <div class="echo-list">
          {resolved.map((e) => {
            const w = (e.weight === 2 || e.weight === 3 ? e.weight : 1) as 1 | 2 | 3;
            return (
              <article class="kod-plate echo echo--resolved">
                <div class="echo__weight">
                  <span class="weight-segs" aria-label={`Weight ${w}`}>
                    {[1, 2, 3].map((i) => (
                      <i class={i <= w ? 'on' : ''} />
                    ))}
                  </span>
                  <span class="weight-band">{WEIGHT_BAND[w]}</span>
                </div>
                <div class="echo__body">
                  <h3 class="echo__title">{e.title}</h3>
                  <p class="echo__resolution">
                    <span class="echo__resolution-lab">Resolution</span>
                    {e.resolved?.narrative}
                  </p>
                  {
                    desk && (
                      <p>
                        <button type="button" data-desk-reopen data-title={e.title}>
                          Reopen
                        </button>
                        {(w === 2 || w === 3) && (
                          <label>
                            Claim legacy
                            <select data-desk-claim data-title={e.title}>
                              <option value="">Choose a living person</option>
                              {living.map((person) => (
                                <option value={person.slug}>{person.name}</option>
                              ))}
                            </select>
                          </label>
                        )}
                      </p>
                    )
                  }
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="kod-plate" id="traits-panel">
    <div class="section-head">
      <h2>Traits</h2>
    </div>
    <ul class="trait-list" data-trait-list>
      {
        ch.traits.length === 0 && !sheetEdit ? (
          <li class="empty">None recorded.</li>
        ) : (
          ch.traits.map((t, idx) => (
            <li class="kod-plate trait" data-trait-idx={String(idx)}>
              {
                sheetEdit ? (
                  <div class="trait__edit">
                    <input class="kod-ink" data-trait-name value={t.name} placeholder="Trait name" autocomplete="off" />
                    <input class="kod-ink" data-trait-note value={t.note ?? ''} placeholder="Optional note" autocomplete="off" />
                    <button type="button" class="desk-mark" data-trait-remove aria-label="Remove" data-tip="Remove">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.4" />
                      </svg>
                    </button>
                  </div>
                ) : (
                  <span class="trait__name">
                    {t.name}
                    {t.note && (
                      <button type="button" class="info" data-tip={t.note} aria-label="Trait note">
                        i
                      </button>
                    )}
                  </span>
                )
              }
            </li>
          ))
        )
      }
      {
        desk && (
          <li class="kod-plate trait" data-trait-new>
            <div class="trait__edit">
              <input class="kod-ink" data-trait-name placeholder="Trait name" autocomplete="off" />
              <input class="kod-ink" data-trait-note placeholder="Note" autocomplete="off" />
            </div>
          </li>
        )
      }
    </ul>
    {
      sheetEdit && !desk && (
        <button type="button" class="draft-btn" data-trait-add style="margin-top:0.65rem">
          + Add Trait
        </button>
      )
    }
    <p class="draft-msg" data-echoes-msg hidden></p>
    {sheetEdit && (
      <script id="echo-resolved" type="application/json" set:html={JSON.stringify(resolved)} />
    )}
    {sheetEdit && (
      <script id="trait-seed" type="application/json" set:html={JSON.stringify(ch.traits)} />
    )}
  </section>

  {
    sheetEdit && (
      <script is:inline src="/sheet-edit-echoes.js?v=20261017d"></script>
    )
  }
  </SheetChrome>
</CampaignLayout>

<style>
  .echo__weight--edit {
    cursor: pointer;
  }
  .echo__title-input {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .echo__invoke-edit {
    display: grid;
    gap: 0.25rem;
  }
  .echo__remove,
  .trait__edit button,
  .draft-btn {
    font: inherit;
    cursor: pointer;
    margin-top: 0.45rem;
    padding: 0.3rem 0.65rem;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--kod-silver) 35%, transparent);
  }
  .draft-btn--primary {
    border-color: color-mix(in srgb, var(--kod-blood) 60%, transparent);
    background: color-mix(in srgb, var(--kod-blood) 18%, transparent);
  }
  .trait__edit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.6rem;
    width: 100%;
    align-items: center;
  }
  .trait__edit button {
    grid-row: 1 / span 2;
    grid-column: 2;
    margin-top: 0;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0.2rem;
  }
</style>
