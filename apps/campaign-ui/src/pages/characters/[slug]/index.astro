---
export const prerender = false;

import { nextFoundationCost, nextSkillCost } from '@kodranni/app';
import { ARCHETYPES, FOUNDATION_GROUPS, FOUNDATION_HARM } from '@kodranni/domain';
import BudgetDock from '../../../components/BudgetDock.astro';
import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import ConfirmDock from '../../../components/ConfirmDock.astro';
import SheetChrome from '../../../components/SheetChrome.astro';
import SkillSeal from '../../../components/SkillSeal.astro';
import WantingPanel from '../../../components/WantingPanel.astro';
import { getCharacter, loadCommunity } from '../../../data/load';
import { harmPips, segments } from '../../../lib/format';
import { editCookieHeader, resolveSheetEdit } from '../../../lib/sheet-auth';

const { slug } = Astro.params;
const c = loadCommunity();
const ch = getCharacter(slug!);
if (!ch) {
  return new Response('Character not found', { status: 404, statusText: 'Not Found' });
}

const skillMap = new Map(ch.skills.map((s) => [s.name, s]));
const exSegs = segments(ch.exertion.current, ch.exertion.max);
const echoSegs = segments(ch.echoWeight, ch.echoCapacity);
const live = c.source === 'live';
const unlocked = Boolean(live && ch.creation && !ch.creation.locked);
const auth = resolveSheetEdit(Astro.request, Astro.url, ch.slug);
if (auth.canEdit && auth.token && Astro.url.searchParams.has('edit')) {
  Astro.response.headers.append('Set-Cookie', editCookieHeader(auth.token));
}
/** Unlocked sheet + valid bot-signed edit token. */
const canEdit = unlocked && auth.canEdit;
const foundationPts = ch.creation?.foundationPoints ?? 0;
const skillPts = ch.creation?.skillPoints ?? 0;

function practiceFrac(practice: number, threshold: number): number {
  if (threshold <= 0) return 0;
  return Math.min(1, Math.max(0, practice / threshold));
}

const roman = (n: number) => ['∅', 'I', 'II', 'III', 'IV'][n] ?? String(n);
---

<CampaignLayout
  title={ch.name}
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <SheetChrome
    slug={ch.slug}
    name={ch.name}
    playerDisplay={ch.player?.displayName}
    playerPlatform={ch.player?.platform}
    avatar={ch.avatar}
    status={ch.status}
    dying={ch.dying}
    decadence={ch.flags.decadence}
    overCapacity={ch.flags.overCapacity}
    live={live}
    tab="core"
    showDraftTab={canEdit}
    canEdit={canEdit}
  >
  <BudgetDock character={ch} live={live} canEdit={canEdit} />
  <WantingPanel character={ch} live={live} canEdit={canEdit} />
  <ConfirmDock character={ch} live={live} canEdit={canEdit} />
  {
    canEdit && (
      <aside class="wanting-tracker" id="wanting-tracker" hidden aria-live="polite">
        <div class="wanting-tracker__head">
          <div>
            <p class="wanting-tracker__kicker">The Wanting</p>
            <p class="wanting-tracker__title" data-wanting-tracker-title>Pick a Wanting line</p>
          </div>
          <span class="wanting-tracker__status" data-wanting-tracker-status>Waiting for menu</span>
        </div>
        <div class="wanting-tracker__rows" data-wanting-tracker-body></div>
      </aside>
    )
  }
  {canEdit && <script is:inline src="/creation-client.js"></script>}

  <div slot="stage" class="core-grid">
    <aside
      class="kod-plate vtrack"
      aria-label={`Exertion ${ch.exertion.current} of ${ch.exertion.max}`}
    >
      <span class="vtrack__label">Exertion</span>
      <div class="vtrack__segs">
        {
          exSegs.map((s) => (
            <span
              class:list={[
                'vtrack__seg',
                s.on && 'vtrack__seg--on',
                s.over && 'vtrack__seg--over',
              ]}
            />
          ))
        }
      </div>
      <div class="vtrack__readout">
        {ch.exertion.current}
        <small>/ {ch.exertion.max}</small>
      </div>
      <button
        type="button"
        class="info"
        data-tip="Res + Con + Cha. One segment = 1. Empty pool → −2 dice on rolls."
        aria-label="About Exertion"
      >
        i
      </button>
    </aside>

    <div class="core-main">
      {
        unlocked && !canEdit && live && (
          <p class="app__meta" style="margin:0 0 0.75rem">
            Sheet is unlocked but <strong>read-only</strong> here — open the link from the table bot
            (<code>/create</code> or review) to edit.
          </p>
        )
      }

      {
        ch.whoWeSee ? (
          <blockquote class="who-quote">
            <span class="who-quote__lab">Who do we see?</span>
            <p class="who-quote__text">{ch.whoWeSee}</p>
          </blockquote>
        ) : null
      }

      <section class="kod-plate" id="section-foundations">
        <div class="section-head">
          <h2>Foundations · Harm</h2>
          <button
            type="button"
            class="info"
            data-tip={
              canEdit
                ? 'Left-click raise · right-click lower (refund). Harm pips stay on the right.'
                : 'Physical / Mental / Social. Rank as Roman mark; Harm as blood pips on the paired track (max 3).'
            }
            aria-label="About Foundations"
          >
            i
          </button>
        </div>
        <div class="found-groups">
          {
            Object.entries(FOUNDATION_GROUPS).map(([group, keys]) => (
              <div class="kod-plate found-group">
                <p class="found-group__title">{group}</p>
                {keys.map((fname) => {
                  const raw = ch.foundations[fname] ?? 0;
                  const eff = ch.foundationsEffective[fname] ?? raw;
                  const harmName = FOUNDATION_HARM[fname] ?? '';
                  const harmPts = ch.harm[harmName] ?? 0;
                  const nextCost = canEdit ? nextFoundationCost(raw) : null;
                  const canRaise =
                    canEdit && nextCost != null && foundationPts >= nextCost;
                  const canLower = canEdit && raw > 1;
                  const tipBase =
                    eff !== raw
                      ? `Effective ${roman(eff)} · raw ${roman(raw)}`
                      : `Rank ${roman(eff)}`;
                  const tip = canEdit
                    ? raw === 0
                      ? canRaise
                        ? `${tipBase} · left-click restore to I (costs ${nextCost})`
                        : `${tipBase} · need ${nextCost ?? 1} pts or Wanting +1`
                      : `${tipBase} · left-click raise · right-click lower`
                    : tipBase;
                  return (
                    <div class="found-row">
                      <span class="found-row__name">{fname}</span>
                      <span class="found-row__val">
                        {
                          canEdit ? (
                            <button
                              type="button"
                              class:list={[
                                'found-row__spend',
                                canEdit && !canRaise && nextCost != null && 'found-row__spend--blocked',
                              ]}
                              data-spend-foundation={fname}
                              data-rating={String(raw)}
                              disabled={!canRaise && !canLower}
                              data-unaffordable={
                                canEdit && !canRaise && nextCost != null ? '1' : undefined
                              }
                              data-tip={tip}
                              aria-label={
                                canRaise
                                  ? `Raise ${fname} to ${roman((raw || 0) + 1)} (costs ${nextCost})`
                                  : canLower
                                    ? `Lower ${fname} with right-click`
                                    : raw === 0
                                      ? `${fname} at ∅ — need points or Wanting`
                                      : `${fname} unavailable`
                              }
                            >
                              <span data-roman>{roman(raw)}</span>
                            </button>
                          ) : (
                            <span data-tip={tip}>
                              {roman(eff)}
                              {eff !== raw ? `*` : ''}
                            </span>
                          )
                        }
                      </span>
                      <span class="found-row__harm">
                        <span class="found-row__harm-name">{harmName}</span>
                        <span class="pips" aria-label={`${harmPts} of 3`}>
                          {harmPips(harmPts).map((on) => (
                            <span class:list={['pip', on && 'pip--on']} />
                          ))}
                        </span>
                      </span>
                    </div>
                  );
                })}
              </div>
            ))
          }
        </div>
      </section>

      <section class="kod-plate" id="section-skills">
        <div class="section-head">
          <h2>Skills by Archetype</h2>
          <button
            type="button"
            class="info"
            data-tip={
              canEdit
                ? 'Left-click raise · right-click lower (refund). Centre = rating · ring fills with Practice toward next rank.'
                : 'Centre = rating. The coloured ring fills with Practice toward the next rank. Hover a skill for Practice and Foundation; open About on touch.'
            }
            aria-label="About Skills"
          >
            i
          </button>
        </div>
        <div class="skill-wheel">
          {
            ARCHETYPES.map((arch) => (
              <div class={`arch arch--${arch.id}`}>
                <div class="arch__art" aria-hidden="true">
                  <img
                    src={`/archetypes/${arch.id}.jpg`}
                    alt=""
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="arch__body">
                  <div class="arch__head">
                    <span class="arch__name">{arch.name}</span>
                    <span class="arch__tag">{arch.tag}</span>
                  </div>
                  <ul class="arch__skills">
                    {arch.skills.map((def) => {
                      const prog = skillMap.get(def.name);
                      const rating = prog?.rating ?? 0;
                      const practice = prog?.practice ?? 0;
                      const threshold = prog?.threshold ?? 24;
                      const p =
                        rating > 0 && rating < 3
                          ? practiceFrac(practice, threshold)
                          : rating >= 3
                            ? 1
                            : 0;
                      const pct = Math.round(p * 100);
                      const nextCost = canEdit ? nextSkillCost(rating) : null;
                      const canRaise =
                        canEdit && nextCost != null && skillPts >= nextCost;
                      const tipBase =
                        rating <= 0
                          ? `Untrained · ${def.foundation}`
                          : rating >= 3
                            ? `Rating 3 (max) · ${def.foundation}`
                            : `Rating ${rating} · Practice ${practice}/${threshold} (${pct}% to next) · ${def.foundation}`;
                      const tip = canEdit
                        ? `${tipBase} · left-click raise · right-click lower`
                        : tipBase;
                      return (
                        <li
                          class:list={[
                            'skill',
                            canEdit && canRaise && 'skill--spendable',
                            canEdit && nextCost != null && !canRaise && 'skill--unaffordable',
                            canEdit && nextCost == null && 'skill--unaffordable',
                          ]}
                          data-rating={String(rating)}
                          data-rated={rating > 0 ? 'true' : 'false'}
                          data-spend-skill={canEdit ? def.name : undefined}
                          style={`--p: ${p}`}
                          data-tip={tip}
                          tabindex="0"
                        >
                          <SkillSeal rating={rating} p={p} />
                          <span class="skill__name">{def.name}</span>
                          {
                            canEdit && (
                              <span class="skill__cost">
                                {nextCost != null ? `−${nextCost}` : 'max'}
                              </span>
                            )
                          }
                          <details class="skill__more">
                            <summary>About</summary>
                            <p>{tip}</p>
                          </details>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <aside
      class="kod-plate vtrack vtrack--echo"
      aria-label={`Echo load ${ch.echoWeight} of ${ch.echoCapacity}`}
    >
      <span class="vtrack__label">Echo load</span>
      <div class="vtrack__segs">
        {
          echoSegs.map((s) => (
            <span
              class:list={[
                'vtrack__seg',
                s.on && 'vtrack__seg--on',
                s.over && 'vtrack__seg--over',
              ]}
            />
          ))
        }
      </div>
      <div class="vtrack__readout">
        {ch.echoWeight}
        <small>/ {ch.echoCapacity}</small>
      </div>
      <button
        type="button"
        class="info"
        data-tip="max(Str, Dex) + Int + Auth. Only unresolved Echoes count. Over capacity → −1 on Echo-involved rolls only."
        aria-label="About Echo load"
      >
        i
      </button>
    </aside>
  </div>
  </SheetChrome>
</CampaignLayout>
