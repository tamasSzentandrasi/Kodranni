---
export const prerender = false;

import { nextFoundationCost, nextSkillCost } from '@kodranni/app';
import { ARCHETYPES, FOUNDATION_GROUPS, FOUNDATION_HARM } from '@kodranni/domain';
import { skillPracticeFill } from '@kodranni/hall-render';
import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import CreationChrome from '../../../components/CreationChrome.astro';
import SheetChrome from '../../../components/SheetChrome.astro';
import SkillSeal from '../../../components/SkillSeal.astro';
import { openSqliteStore, type DegradeProposal } from '@kodranni/store';
import { getCharacter, loadCommunity } from '../../../data/load';
import { harmPips } from '../../../lib/format';
import { deskToolsOn } from '../../../lib/loopback';
import { editCookieHeader, redirectSheetEdit, resolveSheetEdit } from '../../../lib/sheet-auth';

const { slug } = Astro.params;
const c = loadCommunity();
const ch = getCharacter(slug!);
if (!ch) {
  return new Response('Character not found', { status: 404, statusText: 'Not Found' });
}
const parkedEdit = redirectSheetEdit(Astro.url, ch.slug);
if (parkedEdit) return parkedEdit;

const skillMap = new Map(ch.skills.map((s) => [s.name, s]));
const exP = ch.exertion.max <= 0 ? 0 : Math.min(1, ch.exertion.current / ch.exertion.max);
const echoP = ch.echoCapacity <= 0 ? 0 : Math.min(1, ch.echoWeight / ch.echoCapacity);
const live = c.source === 'live';
const unlocked = Boolean(live && ch.creation && !ch.creation.locked);
const auth = resolveSheetEdit(Astro.request, Astro.url, ch.slug);
if (auth.canEdit && auth.token) {
  Astro.response.headers.append('Set-Cookie', editCookieHeader(auth.token));
}
/** Unlocked sheet + valid bot-signed edit token. */
const canEdit = unlocked && auth.canEdit;
const desk = live && deskToolsOn(Astro.request);
const playerEdit = canEdit && !desk;
const foundationPts = ch.creation?.foundationPoints ?? 0;
const skillPts = ch.creation?.skillPoints ?? 0;

const roman = (n: number) => ['∅', 'I', 'II', 'III', 'IV'][n] ?? String(n);

let degrade: DegradeProposal | null = null;
if (desk && c.storePath) {
  const proposalStore = openSqliteStore(c.storePath);
  try {
    degrade = proposalStore.getDegradeProposal(ch.slug) ?? null;
  } finally {
    proposalStore.close();
  }
}
---

<CampaignLayout
  title={ch.name}
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <SheetChrome
    slug={ch.slug}
    name={ch.name}
    playerDisplay={ch.player?.displayName}
    playerPlatform={ch.player?.platform}
    avatar={ch.avatar}
    status={ch.status}
    dying={ch.dying}
    decadence={ch.flags.decadence}
    overCapacity={ch.flags.overCapacity}
    live={live}
    tab="core"
    canEdit={playerEdit}
    desk={desk}
    concept={ch.concept}
    communityTie={ch.communityTie}
    whoWeSee={ch.whoWeSee}
    claimable={Boolean(ch.creation?.claimable)}
  >
  <CreationChrome character={ch} live={live} canEdit={playerEdit} />
  {desk && <script is:inline src="/desk-sheet.js"></script>}

  <div slot="stage" class="core-grid">
    <aside
      class:list={['vtrack', ch.exertion.current > ch.exertion.max && 'vtrack--over']}
      style={`--well-p:${exP}`}
      aria-label={`Exertion ${ch.exertion.current} of ${ch.exertion.max}`}
    >
      <div class="vtrack__legend">
        <span class="vtrack__label">Exertion</span>
        <div class="vtrack__readout">
          {ch.exertion.current}<span class="vtrack__of">/{ch.exertion.max}</span>
        </div>
        <button
          type="button"
          class="info"
          data-tip={
            desk
              ? 'Click the well. The height sets current exertion, from empty up to Resolve + Constitution + Charisma.'
              : 'Res + Con + Cha. One segment = 1. Empty pool → −2 dice on rolls.'
          }
          aria-label="About Exertion"
        >
          i
        </button>
      </div>
      <div
        class="vtrack__vessel"
        aria-hidden={desk ? undefined : 'true'}
        data-desk-exertion={desk ? '1' : undefined}
        data-max={desk ? String(ch.exertion.max) : undefined}
      >
        <span class="vtrack__fill"></span>
        <span class="vtrack__frame"></span>
      </div>
    </aside>

    <div class="core-main">
      {
        unlocked && !canEdit && !desk && live && (
          <p class="app__meta" style="margin:0 0 0.75rem">
            Sheet is unlocked but <strong>read-only</strong> here — open the link from the table bot
            (<code>/create</code> or review) to edit.
          </p>
        )
      }

      <section class="kod-plate" id="section-foundations">
        <div class="section-head">
          <h2>Foundations · Harm</h2>
          <button
            type="button"
            class="info"
            data-tip={
              desk
                ? 'Left-click the mark raises it. Right-click lowers it. Harm pips work the same way.'
                : canEdit
                  ? 'Left-click raise · right-click lower (refund). Harm pips stay on the right.'
                  : 'Physical / Mental / Social. Rank as Roman mark; Harm as blood pips on the paired track (max 3).'
            }
            aria-label="About Foundations"
          >
            i
          </button>
        </div>
        <div class="found-groups">
          {
            Object.entries(FOUNDATION_GROUPS).map(([group, keys]) => (
              <div class={`kod-plate found-group found-group--${group.toLowerCase()}`}>
                <p class="found-group__title">{group}</p>
                {keys.map((fname) => {
                  const raw = ch.foundations[fname] ?? 0;
                  const eff = ch.foundationsEffective[fname] ?? raw;
                  const harmName = FOUNDATION_HARM[fname] ?? '';
                  const harmPts = ch.harm[harmName] ?? 0;
                  const nextCost = playerEdit ? nextFoundationCost(raw) : null;
                  const canRaise =
                    playerEdit && nextCost != null && foundationPts >= nextCost;
                  const canLower = playerEdit && raw > 1;
                  const tipBase =
                    eff !== raw
                      ? `Effective ${roman(eff)} · raw ${roman(raw)}`
                      : `Rank ${roman(eff)}`;
                  const tip = desk
                    ? `${tipBase} · left-click raises · right-click lowers`
                    : playerEdit
                      ? raw === 0
                        ? canRaise
                          ? `${tipBase} · left-click restore to I (costs ${nextCost})`
                          : `${tipBase} · need ${nextCost ?? 1} pts or Wanting +1`
                        : `${tipBase} · left-click raise · right-click lower`
                      : tipBase;
                  return (
                    <div class="found-row">
                      <span class="found-row__name">{fname}</span>
                      <span class="found-row__val">
                        {
                          desk ? (
                            <button
                              type="button"
                              class="found-row__spend"
                              data-desk-foundation={fname}
                              data-rating={String(raw)}
                              data-tip={tip}
                              aria-label={`${fname} ${roman(raw)}`}
                            >
                              <span data-roman>{roman(raw)}</span>
                            </button>
                          ) : playerEdit ? (
                            <button
                              type="button"
                              class:list={[
                                'found-row__spend',
                                !canRaise && nextCost != null && 'found-row__spend--blocked',
                              ]}
                              data-spend-foundation={fname}
                              data-rating={String(raw)}
                              disabled={!canRaise && !canLower}
                              data-unaffordable={!canRaise && nextCost != null ? '1' : undefined}
                              data-tip={tip}
                              aria-label={
                                canRaise
                                  ? `Raise ${fname} to ${roman((raw || 0) + 1)} (costs ${nextCost})`
                                  : canLower
                                    ? `Lower ${fname} with right-click`
                                    : raw === 0
                                      ? `${fname} at ∅ — need points or Wanting`
                                      : `${fname} unavailable`
                              }
                            >
                              <span data-roman>{roman(raw)}</span>
                            </button>
                          ) : (
                            <span data-tip={tip}>
                              {roman(eff)}
                              {eff !== raw ? `*` : ''}
                            </span>
                          )
                        }
                        {desk && eff !== raw ? <span data-effective>effective {roman(eff)}</span> : null}
                      </span>
                      <span class="found-row__harm" data-desk-harm={desk ? harmName : undefined}>
                        <span class="found-row__harm-name">{harmName}</span>
                        <span class="pips" aria-label={`${harmPts} of 3`}>
                          {harmPips(harmPts).map((on) => (
                            <span class:list={['pip', on && 'pip--on']} />
                          ))}
                        </span>
                      </span>
                    </div>
                  );
                })}
              </div>
            ))
          }
        </div>
        {
          desk && (
            <form class="dying-confirm" data-desk-stabilise-form hidden={!ch.dying}>
              <p>
                Roll Resolve + Healing first. Then record the Trait that remains. An empty name
                still clears Dying. The track stays at 3.
              </p>
              <label>
                Trait
                <input class="kod-ink" data-stabilise-name autocomplete="off" />
              </label>
              <label>
                Note
                <input class="kod-ink" data-stabilise-note autocomplete="off" />
              </label>
              <button type="button" class="kod-btn" data-desk-stabilise>
                Stabilise
              </button>
            </form>
          )
        }
      </section>

      {
        desk && (
          <section class="kod-plate time-leap" id="section-time-leap">
            <div class="section-head">
              <h2>Time leap</h2>
            </div>
            <p>
              A standard leap can take up to three of the five lowest Skills. A short leap can take one.
              The omen can also take none. Confirm writes that pick. Dismiss writes nothing.
            </p>
            <div class="time-leap__actions">
              <button type="button" class="kod-btn" data-degrade-mode="standard">
                Standard
              </button>
              <button type="button" class="kod-btn" data-degrade-mode="short">
                Short
              </button>
            </div>
            <div data-degrade-panel hidden={!degrade}>
              <p data-degrade-read>
                {
                  degrade
                    ? `${degrade.mode === 'short' ? 'Short' : 'Standard'} · omen ${degrade.omen} · ${degrade.picked.length} of ${degrade.pool.length}`
                    : ''
                }
              </p>
              <p data-degrade-pool>{degrade ? `Pool: ${degrade.pool.join(', ') || 'none'}` : ''}</p>
              <p data-degrade-picked>
                {degrade ? `Picked: ${degrade.picked.join(', ') || 'none'}` : ''}
              </p>
              <div class="time-leap__actions">
                <button type="button" class="kod-btn" data-degrade-confirm>
                  Confirm
                </button>
                <button type="button" class="kod-btn" data-degrade-dismiss>
                  Dismiss
                </button>
              </div>
            </div>
          </section>
        )
      }

      <section class="kod-plate" id="section-skills">
        <div class="section-head">
          <h2>Skills by Archetype</h2>
          <button
            type="button"
            class="info"
            data-tip={
              desk
                ? 'Left-click raises the rating. Right-click lowers it. Hold to add or remove Practice.'
                : canEdit
                  ? 'Left-click raise · right-click lower (refund). Centre = rating · ring fills with Practice toward next rank.'
                  : 'Centre = rating. The coloured ring fills with Practice toward the next rank. Hover a skill for Practice and Foundation; open About on touch.'
            }
            aria-label="About Skills"
          >
            i
          </button>
        </div>
        <div class="skill-wheel">
          {
            ARCHETYPES.map((arch) => (
              <div class={`arch arch--${arch.id}`}>
                <div class="arch__art" aria-hidden="true">
                  <img
                    src={`/archetypes/${arch.id}.jpg`}
                    alt=""
                    width="400"
                    height="400"
                    decoding="async"
                  />
                </div>
                <div class="arch__body">
                  <div class="arch__head">
                    <span class="arch__name">{arch.name}</span>
                    <span class="arch__tag">{arch.tag}</span>
                  </div>
                  <ul class="arch__skills">
                    {arch.skills.map((def) => {
                      const prog = skillMap.get(def.name);
                      const rating = prog?.rating ?? 0;
                      const practice = prog?.practice ?? 0;
                      const threshold = prog?.threshold ?? 24;
                      const p = skillPracticeFill(rating, practice, threshold);
                      const pct = Math.round(p * 100);
                      const nextCost = playerEdit ? nextSkillCost(rating) : null;
                      const canRaise =
                        playerEdit && nextCost != null && skillPts >= nextCost;
                      const tipBase =
                        rating >= 3
                          ? `Rating 3 (max) · ${def.foundation}`
                          : rating <= 0
                            ? `Untrained · Practice ${practice}/${threshold} (${pct}% to next) · ${def.foundation}`
                            : `Rating ${rating} · Practice ${practice}/${threshold} (${pct}% to next) · ${def.foundation}`;
                      const tip = desk
                        ? `${tipBase} · left-click raises · right-click lowers · hold changes Practice`
                        : playerEdit
                          ? `${tipBase} · left-click raise · right-click lower`
                          : tipBase;
                      return (
                        <li
                          class:list={[
                            'skill',
                            playerEdit && canRaise && 'skill--spendable',
                            playerEdit && nextCost != null && !canRaise && 'skill--unaffordable',
                            playerEdit && nextCost == null && 'skill--unaffordable',
                          ]}
                          data-rating={String(rating)}
                          data-rated={rating > 0 ? 'true' : 'false'}
                          data-spend-skill={playerEdit ? def.name : undefined}
                          data-desk-skill={desk ? def.name : undefined}
                          data-practice={desk ? String(practice) : undefined}
                          data-threshold={desk ? String(threshold) : undefined}
                          style={`--p: ${p}`}
                          data-tip={tip}
                          tabindex="0"
                        >
                          <SkillSeal rating={rating} p={p} />
                          <span class="skill__name">{def.name}</span>
                          {
                            desk && (
                              <span class="skill__practice" hidden={rating >= 3}>
                                {rating < 3 ? `${practice}/${threshold}` : ''}
                              </span>
                            )
                          }
                          {
                            playerEdit && (
                              <span class="skill__cost">
                                {nextCost != null ? `−${nextCost}` : 'max'}
                              </span>
                            )
                          }
                          <details class="skill__more">
                            <summary>About</summary>
                            <p>{tip}</p>
                          </details>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <aside
      class:list={['vtrack', 'vtrack--echo', ch.echoWeight > ch.echoCapacity && 'vtrack--over']}
      style={`--well-p:${echoP}`}
      aria-label={`Echo load ${ch.echoWeight} of ${ch.echoCapacity}`}
    >
      <div class="vtrack__legend">
        <span class="vtrack__label">Echo load</span>
        <div class="vtrack__readout">
          {ch.echoWeight}<span class="vtrack__of">/{ch.echoCapacity}</span>
        </div>
        <button
          type="button"
          class="info"
          data-tip="max(Str, Dex) + Int + Auth. Only unresolved Echoes count. Over capacity → −1 on Echo-involved rolls only."
          aria-label="About Echo load"
        >
          i
        </button>
      </div>
      <div class="vtrack__vessel" aria-hidden="true">
        <span class="vtrack__fill"></span>
        <span class="vtrack__frame"></span>
      </div>
    </aside>
  </div>
  </SheetChrome>
</CampaignLayout>
