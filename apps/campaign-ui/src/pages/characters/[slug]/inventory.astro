---
export const prerender = false;

import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import SheetChrome from '../../../components/SheetChrome.astro';
import { getCharacter, loadCommunity } from '../../../data/load';
import { editCookieHeader, resolveSheetEdit } from '../../../lib/sheet-auth';

const { slug } = Astro.params;
const c = loadCommunity();
const ch = getCharacter(slug!);
if (!ch) {
  return new Response('Character not found', { status: 404, statusText: 'Not Found' });
}

const live = c.source === 'live';
const unlocked = Boolean(live && ch.creation && !ch.creation.locked);
const auth = resolveSheetEdit(Astro.request, Astro.url, ch.slug);
if (auth.canEdit && auth.token && Astro.url.searchParams.has('edit')) {
  Astro.response.headers.append('Set-Cookie', editCookieHeader(auth.token));
}
const canEdit = unlocked && auth.canEdit;
const armourLabel =
  ch.armour.kind === 'none' ? 'None' : ch.armour.kind === 'light' ? 'Light' : 'Heavy';
---

<CampaignLayout
  title={`${ch.name} · Inventory`}
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <SheetChrome
    slug={ch.slug}
    name={ch.name}
    playerDisplay={ch.player?.displayName}
    playerPlatform={ch.player?.platform}
    avatar={ch.avatar}
    status={ch.status}
    dying={ch.dying}
    decadence={ch.flags.decadence}
    overCapacity={ch.flags.overCapacity}
    live={live}
    tab="inventory"
    showDraftTab={canEdit}
    canEdit={canEdit}
  >

  <section
    class="kod-plate"
    id="inventory-panel"
    data-slug={ch.slug}
    data-can-edit={canEdit ? '1' : '0'}
    data-armour-kind={ch.armour.kind}
    data-armour-donned={ch.armour.donned ? '1' : '0'}
  >
    <div class="section-head">
      <h2>Inventory</h2>
      <button
        type="button"
        class="info"
        data-tip="Armour click cycles None → Light → Heavy. Food/Water use ±. Items: name + optional note."
        aria-label="About Inventory"
      >
        i
      </button>
    </div>

    <div class="inv-grid">
      <div>
        <button
          type="button"
          class="kod-plate armour"
          data-kind={ch.armour.kind}
          data-donned={String(ch.armour.donned)}
          data-armour-cycle={canEdit ? '1' : undefined}
          disabled={!canEdit}
        >
          <span class="armour__lab">Armour</span>
          <span class="armour__val" data-armour-label>{armourLabel}</span>
          <span class="armour__state" data-armour-state>
            {
              ch.armour.kind === 'none'
                ? 'No armour'
                : ch.armour.donned
                  ? 'Donned — counts for physical Harm'
                  : 'Carried — click again ideas…'
            }
          </span>
        </button>
        {
          canEdit && ch.armour.kind !== 'none' && (
            <label class="armour-donned">
              <input type="checkbox" data-armour-donned-toggle checked={ch.armour.donned} />
              Donned
            </label>
          )
        }

        <div class="supplies">
          <div class="kod-plate supply" data-supply="food">
            <span class="supply__lab">Food</span>
            <div class="supply__ctrl">
              {
                canEdit && (
                  <button type="button" class="supply__btn" data-supply-delta="-1" aria-label="Less food">
                    −
                  </button>
                )
              }
              <span class="supply__val" data-supply-val>{ch.inventory.foodDays}</span>
              {
                canEdit && (
                  <button type="button" class="supply__btn" data-supply-delta="1" aria-label="More food">
                    +
                  </button>
                )
              }
            </div>
            <span class="app__meta" style="margin:0">days</span>
          </div>
          <div class="kod-plate supply" data-supply="water">
            <span class="supply__lab">Water</span>
            <div class="supply__ctrl">
              {
                canEdit && (
                  <button type="button" class="supply__btn" data-supply-delta="-1" aria-label="Less water">
                    −
                  </button>
                )
              }
              <span class="supply__val" data-supply-val>{ch.inventory.waterDays}</span>
              {
                canEdit && (
                  <button type="button" class="supply__btn" data-supply-delta="1" aria-label="More water">
                    +
                  </button>
                )
              }
            </div>
            <span class="app__meta" style="margin:0">days</span>
          </div>
        </div>
      </div>

      <div>
        <h3 style="font-size:1rem;margin:0 0 0.4rem">Named items</h3>
        <ul class="item-list" data-item-list>
          {
            ch.inventory.items.length === 0 && !canEdit ? (
              <li class="empty">None declared.</li>
            ) : (
              ch.inventory.items.map((it, idx) => (
                <li class="kod-plate item" data-item-idx={String(idx)}>
                  {
                    canEdit ? (
                      <div class="item__edit">
                        <input class="kod-ink" data-item-name value={it.name} placeholder="Name" />
                        <input
                          class="kod-ink"
                          data-item-note
                          value={it.note ?? ''}
                          placeholder="Short description (optional)"
                        />
                        <button type="button" data-item-remove>
                          Remove
                        </button>
                      </div>
                    ) : (
                      <span class="item__name">
                        {it.name}
                        {it.note && (
                          <button
                            type="button"
                            class="info"
                            data-tip={it.note}
                            aria-label={`${it.name} note`}
                          >
                            i
                          </button>
                        )}
                      </span>
                    )
                  }
                </li>
              ))
            )
          }
        </ul>
        {
          canEdit && (
            <button type="button" class="draft-btn" data-item-add style="margin-top:0.55rem">
              + Add item
            </button>
          )
        }
      </div>
    </div>

    {
      canEdit && (
        <div style="margin-top:1rem">
          <button type="button" class="draft-btn draft-btn--primary" data-save-inventory>
            Save Inventory
          </button>
          <p class="draft-msg" data-inv-msg hidden></p>
        </div>
      )
    }
  </section>

  {canEdit && <script is:inline src="/sheet-edit-inventory.js"></script>}
  </SheetChrome>
</CampaignLayout>

<style>
  .armour[data-armour-cycle='1'] {
    cursor: pointer;
  }
  .armour:disabled {
    cursor: default;
  }
  .armour-donned {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin: 0.45rem 0 0.75rem;
    font-size: 0.85rem;
    color: var(--kod-silver);
  }
  .supply__btn {
    width: 1.6rem;
    height: 1.6rem;
    flex: 0 0 auto;
    font: inherit;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    color: var(--kod-silver-bright);
    background: #0c0a0a;
    border: 1px solid color-mix(in srgb, var(--kod-silver) 35%, transparent);
  }
  .supply__btn:hover {
    border-color: var(--kod-blood);
  }
  .item__edit {
    display: grid;
    gap: 0.3rem;
    width: 100%;
  }
  .item__edit button,
  .draft-btn {
    font: inherit;
    cursor: pointer;
    padding: 0.3rem 0.65rem;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--kod-silver) 35%, transparent);
    justify-self: start;
  }
  .draft-btn--primary {
    border-color: color-mix(in srgb, var(--kod-blood) 60%, transparent);
    background: color-mix(in srgb, var(--kod-blood) 18%, transparent);
  }
</style>
