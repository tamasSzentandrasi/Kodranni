---
export const prerender = false;

import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import { getCharacter, loadCommunity } from '../../../data/load';
import {
  ECHO_PHASES,
  WEIGHT_BAND,
  avatarUrl,
  monogram,
  phaseOf,
  segments,
} from '../../../lib/format';

const { slug } = Astro.params;
const c = loadCommunity();
const ch = getCharacter(slug!);
if (!ch) {
  return new Response('Character not found', { status: 404, statusText: 'Not Found' });
}

const armourLabel =
  ch.armour.kind === 'none' ? 'None' : ch.armour.kind === 'light' ? 'Light' : 'Heavy';

const echoSegs = segments(ch.echoWeight, ch.echoCapacity);
const exSegs = segments(ch.exertion.current, ch.exertion.max);
const av = avatarUrl(ch.slug, ch.avatar);
---

<CampaignLayout
  title={`${ch.name} · Burden`}
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <nav class="subtabs" aria-label="Sheet sections">
    <a href={`/characters/${ch.slug}/`}>Core</a>
    <a href={`/characters/${ch.slug}/burden/`} aria-current="page">Echoes · Inventory · Traits</a>
    <a href={`/characters/?sel=${ch.slug}`}>← Browse</a>
  </nav>

  <div class="sheet-head">
    {
      av ? (
        <img class="avatar avatar--lg" src={av} alt="" width="80" height="80" />
      ) : (
        <span class="avatar avatar--lg avatar--mono" aria-hidden="true">
          {monogram(ch.name)}
        </span>
      )
    }
    <div>
      <h1 class="sheet__name">{ch.name}</h1>
      <div class="track-row" style="max-width:28rem">
        <div class="track-block" style="margin:0">
          <span class="track-block__label">Exertion</span>
          <div class="segbar" aria-label={`Exertion ${ch.exertion.current}/${ch.exertion.max}`}>
            {
              exSegs.map((s) => (
                <span
                  class:list={[
                    'segbar__seg',
                    s.on && 'segbar__seg--on',
                    s.over && 'segbar__seg--over',
                  ]}
                />
              ))
            }
            <span class="segbar__readout">
              {ch.exertion.current}/{ch.exertion.max}
            </span>
          </div>
        </div>
        <div class="track-block" style="margin:0">
          <span class="track-block__label">Echo load</span>
          <div
            class="segbar segbar--echo"
            aria-label={`Echo load ${ch.echoWeight}/${ch.echoCapacity}`}
          >
            {
              echoSegs.map((s) => (
                <span
                  class:list={[
                    'segbar__seg',
                    s.on && 'segbar__seg--on',
                    s.over && 'segbar__seg--over',
                  ]}
                />
              ))
            }
            <span class="segbar__readout">
              {ch.echoWeight}/{ch.echoCapacity}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="surface">
    <div class="section-head">
      <h2>Echoes</h2>
      <button
        type="button"
        class="info"
        data-tip="Each Echo is a carried deed. Weight 1 Individual · 2 Group · 3 Pivotal. Effects are grouped: while carried, on resolution, continuity. Info marks hold the rule text."
        aria-label="About Echoes"
      >
        i
      </button>
    </div>

    {
      ch.echoes.length === 0 ? (
        <p class="empty">None — Decadence if this stands (−1 die on every roll).</p>
      ) : (
        <div class="echo-cards">
          {ch.echoes.map((e) => {
            const w = (e.weight === 2 || e.weight === 3 ? e.weight : 1) as 1 | 2 | 3;
            const effects = e.effects ?? [];
            return (
              <article class="echo-card">
                <div class="echo-card__head">
                  <h3 class="echo-card__title">
                    {e.title}
                    {e.note && (
                      <button
                        type="button"
                        class="info"
                        data-tip={e.note}
                        aria-label="Echo description"
                      >
                        i
                      </button>
                    )}
                  </h3>
                  <div class="echo-card__weight">
                    <span class="weight-segs" aria-label={`Weight ${w}`}>
                      {[1, 2, 3].map((i) => (
                        <i class={i <= w ? 'on' : ''} />
                      ))}
                    </span>
                    <span class="weight-band">{WEIGHT_BAND[w]}</span>
                  </div>
                </div>
                <div class="echo-phases">
                  {ECHO_PHASES.map((phase) => {
                    const cells = effects.filter((fx) => phaseOf(fx) === phase.id);
                    return (
                      <div class="echo-phase">
                        <p class="echo-phase__lab">{phase.label}</p>
                        <div class="echo-phase__list">
                          {cells.length === 0 ? (
                            <span class="empty">—</span>
                          ) : (
                            cells.map((fx) => (
                              <span class="fx" data-kind={fx.kind}>
                                {fx.label}
                                {fx.detail && (
                                  <button
                                    type="button"
                                    class="info"
                                    data-tip={fx.detail}
                                    aria-label="Effect detail"
                                  >
                                    i
                                  </button>
                                )}
                              </span>
                            ))
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </section>

  <section class="surface">
    <div class="section-head">
      <h2>Traits</h2>
      <button
        type="button"
        class="info"
        data-tip="Standing marks of character — often born from resolved Echoes. Info mark holds the ST note."
        aria-label="About Traits"
      >
        i
      </button>
    </div>
    <ul class="trait-list">
      {
        ch.traits.length === 0 ? (
          <li class="empty">None recorded.</li>
        ) : (
          ch.traits.map((t) => (
            <li class="trait">
              <span class="trait__name">
                {t.name}
                {t.note && (
                  <button type="button" class="info" data-tip={t.note} aria-label="Trait note">
                    i
                  </button>
                )}
              </span>
            </li>
          ))
        )
      }
    </ul>
  </section>

  <section class="surface">
    <div class="section-head">
      <h2>Inventory</h2>
      <button
        type="button"
        class="info"
        data-tip="Explicit possession. If it is not listed, they do not have it. Armour only counts when donned."
        aria-label="About Inventory"
      >
        i
      </button>
    </div>

    <div class="inv-grid">
      <div>
        <div class="armour" data-kind={ch.armour.kind} data-donned={String(ch.armour.donned)}>
          <span class="armour__lab">Armour</span>
          <span class="armour__val">{armourLabel}</span>
          <span class="armour__state">
            {ch.armour.donned
              ? 'Donned — counts for physical Harm ratios'
              : 'Not donned — no armour protection ratio'}
          </span>
        </div>

        <div class="supplies">
          <div class="supply">
            <span class="supply__lab">Food</span>
            <span class="supply__val">{ch.inventory.foodDays}</span>
            <span class="app__meta" style="margin:0">days</span>
          </div>
          <div class="supply">
            <span class="supply__lab">Water</span>
            <span class="supply__val">{ch.inventory.waterDays}</span>
            <span class="app__meta" style="margin:0">days</span>
          </div>
        </div>
      </div>

      <div>
        <h3 style="font-size:0.95rem;margin:0 0 0.35rem">Named items</h3>
        <ul class="item-list">
          {
            ch.inventory.items.length === 0 ? (
              <li class="empty">None declared.</li>
            ) : (
              ch.inventory.items.map((it) => (
                <li class="item">
                  <span class="item__name">
                    {it.name}
                    {it.note && (
                      <button
                        type="button"
                        class="info"
                        data-tip={it.note}
                        aria-label={`${it.name} note`}
                      >
                        i
                      </button>
                    )}
                  </span>
                </li>
              ))
            )
          }
        </ul>
      </div>
    </div>
  </section>
</CampaignLayout>
