---
export const prerender = false;

import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import { getCharacter, loadCommunity } from '../../../data/load';
const { slug } = Astro.params;
const c = loadCommunity();
const ch = getCharacter(slug!);
if (!ch) {
  return new Response('Character not found', { status: 404, statusText: 'Not Found' });
}

const armourLabel =
  ch.armour.kind === 'none'
    ? 'None'
    : ch.armour.kind === 'light'
      ? 'Light'
      : 'Heavy';
---

<CampaignLayout
  title={`${ch.name} · Burden`}
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <nav class="kod-sheet-tabs" aria-label="Sheet sections">
    <a href={`/characters/${ch.slug}/`}>Core</a>
    <a href={`/characters/${ch.slug}/burden/`} aria-current="page">Echoes · Inventory · Traits</a>
    <a href={`/characters/?sel=${ch.slug}`}>← Browse</a>
  </nav>

  <h1 class="kod-sheet-title">{ch.name}</h1>

  <div class="kod-dual-cap">
    <div class="kod-cap-box">
      <span class="kod-cap-box__label">Exertion (will)</span>
      <div class="kod-cap-box__value">
        {ch.exertion.current} / {ch.exertion.max}
      </div>
      <div class="kod-meter kod-meter--exertion" style="margin-top:0.45rem">
        <span
          style={`width: ${ch.exertion.max ? (100 * ch.exertion.current) / ch.exertion.max : 0}%`}
        ></span>
      </div>
      <span class="kod-cap-box__formula">Res + Con + Cha</span>
    </div>
    <div class="kod-cap-box">
      <span class="kod-cap-box__label">Echo load (burden)</span>
      <div class="kod-cap-box__value">
        {ch.echoWeight} / {ch.echoCapacity}
      </div>
      <div class="kod-meter" style="margin-top:0.45rem">
        <span
          style={`width: ${ch.echoCapacity ? Math.min(100, (100 * ch.echoWeight) / ch.echoCapacity) : 0}%`}
        ></span>
      </div>
      <span class="kod-cap-box__formula">max(Str, Dex) + Int + Auth · over-cap −1 only on Echo rolls</span>
    </div>
  </div>

  <div class="kod-sheet-grid">
    <div>
      <section class="kod-panel">
        <h2>Echoes</h2>
        <ul class="kod-echo-list">
          {
            ch.echoes.length === 0 ? (
              <li class="kod-empty">None — Decadence if this stands.</li>
            ) : (
              ch.echoes.map((e) => (
                <li class="kod-echo">
                  <span class="kod-echo__title">{e.title}</span>{' '}
                  <span class="kod-echo__w">weight {e.weight}</span>
                  {e.note && <span class="kod-item__note">{e.note}</span>}
                </li>
              ))
            )
          }
        </ul>
      </section>

      <section class="kod-panel">
        <h2>Traits</h2>
        <ul class="kod-trait-list">
          {
            ch.traits.length === 0 ? (
              <li class="kod-empty">None recorded.</li>
            ) : (
              ch.traits.map((t) => (
                <li class="kod-trait">
                  <span class="kod-trait__name">{t.name}</span>
                  {t.note && <span class="kod-item__note">{t.note}</span>}
                </li>
              ))
            )
          }
        </ul>
      </section>
    </div>

    <div>
      <!-- Single inventory box: armour + supplies + named items -->
      <section class="kod-panel kod-inventory">
        <h2>Inventory</h2>
        <p class="kod-section__lede">
          Explicit possession only. If it is not listed, the character does not have it.
        </p>

        <div class="kod-armour" data-kind={ch.armour.kind} data-donned={String(ch.armour.donned)}>
          <span class="kod-armour__label">Armour</span>
          <span class="kod-armour__value">{armourLabel}</span>
          <span class="kod-armour__state">
            {ch.armour.donned ? 'Donned — counts for physical Harm ratios' : 'Not donned — no armour ratio'}
          </span>
        </div>

        <div class="kod-supplies">
          <div class="kod-supply">
            <span class="kod-supply__label">Food</span>
            <span class="kod-supply__value">{ch.inventory.foodDays}</span>
            <span class="kod-supply__unit">days remaining</span>
          </div>
          <div class="kod-supply">
            <span class="kod-supply__label">Water</span>
            <span class="kod-supply__value">{ch.inventory.waterDays}</span>
            <span class="kod-supply__unit">days remaining</span>
          </div>
        </div>

        <h3 class="kod-inventory__sub">Named items</h3>
        <ul class="kod-item-list">
          {
            ch.inventory.items.length === 0 ? (
              <li class="kod-empty">None declared.</li>
            ) : (
              ch.inventory.items.map((it) => (
                <li class="kod-item">
                  <span class="kod-item__name">{it.name}</span>
                  {it.note ? (
                    <span class="kod-item__note">{it.note}</span>
                  ) : (
                    <span class="kod-item__note kod-item__note--missing">
                      No contextual note — add what matters for play (use, limit, condition).
                    </span>
                  )}
                </li>
              ))
            )
          }
        </ul>
      </section>
    </div>
  </div>
</CampaignLayout>
