---
export const prerender = false;

import { rosterInner, type HallView } from '@kodranni/hall-render';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { loadCommunity } from '../../data/load';

const c = loadCommunity();
const view: HallView = {
  generatedAt: c.generatedAt,
  community: {
    slug: c.slug,
    name: c.name,
    fortunes: c.fortunes,
    myths: c.myths,
    hierarchyAxes: c.hierarchyAxes,
    ruler: c.ruler,
    rulerCharacterSlug: c.rulerCharacterSlug,
    placements: c.placements,
    outsiders: c.outsiders ?? [],
    factions: c.factions,
  },
  characters: c.characters,
};
const rosterHtml = rosterInner(view, {
  page: Number(Astro.url.searchParams.get('p') || '1'),
  selected: Astro.url.searchParams.get('sel') ?? undefined,
});
---

<CampaignLayout
  title="Characters"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  <Fragment set:html={rosterHtml} />
</CampaignLayout>
