---
export const prerender = false;

import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { loadCommunity } from '../../data/load';
import { avatarUrl, monogram } from '../../lib/format';

const c = loadCommunity();
const selected = Astro.url.searchParams.get('sel') ?? '';
---

<CampaignLayout
  title="Characters"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="characters"
  source={c.source}
>
  {
    c.characters.length === 0 ? (
      <p class="empty">No names on the roster yet.</p>
    ) : (
      <ul class="char-list">
        {c.characters.map((ch) => {
          const src = avatarUrl(ch.slug, ch.avatar);
          const kind = (ch.kind ?? 'pc') === 'npc' ? 'Named' : ch.kind === 'notable' ? 'Notable' : 'Player';
          return (
            <li>
              <a
                class="char-row"
                href={`/characters/${ch.slug}/`}
                data-selected={selected === ch.slug ? 'true' : 'false'}
              >
                {src ? (
                  <img class="avatar" src={src} alt="" width="40" height="40" loading="lazy" />
                ) : (
                  <span class="avatar avatar--mono" aria-hidden="true">
                    {monogram(ch.name)}
                  </span>
                )}
                <span class="char-row__body">
                  <span class="char-row__name">{ch.name}</span>
                  <span class="char-row__meta">
                    {kind}
                    {ch.player?.displayName ? ` · ${ch.player.displayName}` : ''}
                  </span>
                </span>
                <span
                  class:list={['char-card__status', ch.dying && 'char-card__status--dying']}
                  data-status={ch.status}
                >
                  {ch.status === 'pending_review' ? 'pending review' : ch.status}
                  {ch.dying ? ' · dying' : ''}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</CampaignLayout>
