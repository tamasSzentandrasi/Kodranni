---
export const prerender = false;

import { readFileSync } from 'node:fs';
import { sessionReading } from '@kodranni/hall-render';
import {
  campaignPublicUrl,
  defaultCampaignTomlPath,
  emptyTableState,
  openSqliteStore,
  parseCampaignToml,
  readSessionState,
} from '@kodranni/store';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { isArchiveScope, loadCommunity } from '../../data/load';
import { resolveCampaignSlug, resolveStorePath } from '../../lib/campaign-paths';
import { discordRuntimeOn } from '../../lib/discord-boot';
import { fluxerRuntimeOn } from '../../lib/fluxer-boot';
import { deskToolsOn, isLocalDeskRequest } from '../../lib/loopback';
import {
  assembleSession,
  sessionNightLine,
  sessionPageHtml,
  type SessionDeskModel,
  type SessionDiscordFields,
  type SessionFluxerFields,
} from '../../lib/session-desk';

const c = loadCommunity();
const between =
  Astro.request.headers.get('x-kodranni-archive') === '1' ||
  isArchiveScope() ||
  c.source === 'snapshot';
const desk = !between && deskToolsOn(Astro.request);

let reading = sessionReading(emptyTableState());
let deskModel: SessionDeskModel | null = null;
if (!between) {
  const discord: SessionDiscordFields = { guildId: '', channelId: '', roleId: '' };
  const fluxer: SessionFluxerFields = { guildId: '', channelId: '', roleId: '' };
  const slug = resolveCampaignSlug();
  if (desk && slug) {
    try {
      const cfg = parseCampaignToml(readFileSync(defaultCampaignTomlPath(slug), 'utf8'));
      discord.guildId = cfg.discordGuildId ?? '';
      discord.channelId = cfg.discordPlayChannelId ?? '';
      discord.roleId = cfg.discordStorytellerRoleId ?? '';
      fluxer.guildId = cfg.fluxerGuildId ?? '';
      fluxer.channelId = cfg.fluxerPlayChannelId ?? '';
      fluxer.roleId = cfg.fluxerStorytellerRoleId ?? '';
    } catch {
      /* The table is not bound yet. */
    }
  }
  const storePath = resolveStorePath();
  if (storePath) {
    const store = openSqliteStore(storePath);
    try {
      const characters = store.listCharacters();
      const leaps = characters
        .map((ch) => {
          const proposal = store.getDegradeProposal(ch.slug);
          return proposal ? { ...proposal, name: ch.name } : null;
        })
        .filter((row): row is NonNullable<typeof row> => Boolean(row));
      const assembled = assembleSession({
        desk,
        state: store.getTableState(),
        characters,
        events: store.listEvents('CharacterReturnedToTable'),
        discord,
        fluxer,
        discordLive: discordRuntimeOn(),
        fluxerLive: fluxerRuntimeOn(),
        leaps,
      });
      reading = assembled.reading;
      deskModel = assembled.desk;
    } finally {
      store.close();
    }
  } else if (desk) {
    deskModel = assembleSession({
      desk: true,
      state: emptyTableState(),
      characters: [],
      events: [],
      discord,
      fluxer,
      discordLive: discordRuntimeOn(),
      fluxerLive: fluxerRuntimeOn(),
    }).desk;
  }
}
const body = sessionPageHtml({ between, reading, desk: deskModel });
let nightNote = '';
if (!between && isLocalDeskRequest(Astro.request)) {
  const nightSlug = resolveCampaignSlug();
  if (nightSlug) {
    nightNote = sessionNightLine(
      campaignPublicUrl(nightSlug),
      readSessionState(nightSlug)?.tunnel === true,
    );
  }
}
---

<CampaignLayout
  title="Session"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="session"
  source={c.source}
>
  {nightNote && <p class="session-night" data-session-night>{nightNote}</p>}
  <Fragment set:html={body} />
  {!between && <script src="/session.js?v=20261018b" defer></script>}
</CampaignLayout>
