---
export const prerender = false;

import { hierarchyInner, type HallView } from '@kodranni/hall-render';
import CampaignLayout from '../../../layouts/CampaignLayout.astro';
import { loadCommunity } from '../../../data/load';
import { deskToolsOn } from '../../../lib/loopback';

const c = loadCommunity();
const live = c.source === 'live';
const view: HallView = {
  generatedAt: c.generatedAt,
  community: {
    slug: c.slug,
    name: c.name,
    fortunes: c.fortunes,
    myths: c.myths,
    hierarchyAxes: c.hierarchyAxes,
    ruler: c.ruler,
    rulerCharacterSlug: c.rulerCharacterSlug,
    placements: c.placements,
    outsiders: c.outsiders ?? [],
    labelGroups: c.labelGroups,
    labels: c.labels,
    factions: c.factions,
    fortuneLook: c.fortuneLook,
    axisLook: c.axisLook,
    rulerLook: c.rulerLook,
    fortunesFoundedAt: live ? c.fortunesFoundedAt : undefined,
  },
  characters: c.characters,
};
const desk = live && deskToolsOn(Astro.request);
const hallHtml = hierarchyInner(view, { live, canEdit: false, desk });
---

<CampaignLayout
  title="Hierarchy"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="hierarchy"
  source={c.source}
>
  <Fragment set:html={hallHtml} />

  <button type="button" id="kod-hall-banner" class="hall-banner" hidden>
    Record changed — refresh
  </button>
</CampaignLayout>
