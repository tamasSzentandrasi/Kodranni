---
export const prerender = false;

import { overviewInner, type HallView } from '@kodranni/hall-render';
import DeskHall from '../../components/DeskHall.astro';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { loadCommunity } from '../../data/load';
import { readDeskStrip } from '../../lib/desk-status';
import { deskToolsOn } from '../../lib/loopback';

const c = loadCommunity();
const live = c.source === 'live';
const view: HallView = {
  generatedAt: c.generatedAt,
  community: {
    slug: c.slug,
    name: c.name,
    fortunes: c.fortunes,
    myths: c.myths,
    hierarchyAxes: c.hierarchyAxes,
    ruler: c.ruler,
    rulerCharacterSlug: c.rulerCharacterSlug,
    placements: c.placements,
    outsiders: c.outsiders ?? [],
    labelGroups: c.labelGroups,
    labels: c.labels,
    factions: c.factions,
    fortunesFoundedAt: live ? c.fortunesFoundedAt : undefined,
  },
  characters: c.characters,
};
const hallHtml = overviewInner(view, { live, canEdit: false });
const tools = deskToolsOn(Astro.request);
const strip = tools ? await readDeskStrip() : null;
const restoreFlag = Astro.url.searchParams.get('restore');
const notice =
  restoreFlag === 'ok'
    ? 'Snapshot restored.'
    : restoreFlag === 'failed'
      ? 'That file was not a public snapshot.'
      : undefined;
---

<CampaignLayout
  title="Overview"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="overview"
  source={c.source}
>
  <Fragment set:html={hallHtml} />

  {
    tools && (
      <DeskHall
        fortunes={c.fortunes}
        founded={Boolean(c.fortunesFoundedAt)}
        factions={c.factions ?? []}
        outsiders={c.outsiders ?? []}
        discord={strip?.discord ?? { guild: '', channel: '', role: '' }}
        notice={notice}
      />
    )
  }

  <button type="button" id="kod-hall-banner" class="hall-banner" hidden>
    Record changed — refresh
  </button>
</CampaignLayout>
