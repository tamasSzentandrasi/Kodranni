---
export const prerender = false;

import { HIERARCHY_TIERS } from '@kodranni/domain';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import FortuneHall from '../../components/FortuneHall.astro';
import HallSearch from '../../components/HallSearch.astro';
import HierarchyBoard from '../../components/HierarchyBoard.astro';
import OutsiderPorch from '../../components/OutsiderPorch.astro';
import MythList from '../../components/MythList.astro';
import InspectDrawer from '../../components/InspectDrawer.astro';
import { loadCommunity, whoWeSeeMap } from '../../data/load';
import { buildInspectPeople, peopleJson } from '../../lib/hall-inspect';

const c = loadCommunity();
const tips = whoWeSeeMap(c);
const people = buildInspectPeople(c);
const showSearch = people.length > 0;
const tiers = [...HIERARCHY_TIERS];
const live = c.source === 'live';
const founded = Boolean(c.fortunesFoundedAt);
const hideWeather = live && !founded;
---

<CampaignLayout
  title="Community"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="community"
  source={c.source}
>
  {showSearch && <HallSearch axes={c.hierarchyAxes} tiers={tiers} />}
  <div
    class="hall"
    data-slug={c.slug}
    data-source={c.source ?? 'fixture'}
    data-founded={c.fortunesFoundedAt ?? ''}
  >
    {
      hideWeather ? (
        <section class="hall__sky" aria-labelledby="f-h">
          <div class="section-head">
            <h2 id="f-h">Fortunes</h2>
          </div>
          <p class="empty">This people’s weather has not been set.</p>
        </section>
      ) : (
        <FortuneHall fortunes={c.fortunes} founded={founded} />
      )
    }
    <HierarchyBoard
      axes={c.hierarchyAxes}
      ruler={c.ruler}
      rulerCharacterSlug={c.rulerCharacterSlug}
      placements={c.placements}
      pendingMoves={c.pendingMoves ?? []}
      tips={tips}
    />
    <OutsiderPorch outsiders={c.outsiders ?? []} />
    <MythList myths={c.myths} />
  </div>

  <button type="button" id="kod-hall-banner" class="hall-banner" hidden>
    Record changed — refresh
  </button>

  <InspectDrawer peopleJson={peopleJson(people)} />
  <script is:inline src="/hall-client.js"></script>
</CampaignLayout>
