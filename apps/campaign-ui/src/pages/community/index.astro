---
export const prerender = false;

import { HIERARCHY_TIERS } from '@kodranni/domain';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import {
  FORTUNE_LABELS,
  loadCommunity,
  MYTH_KIND_COLUMNS,
  whoWeSeeMap,
} from '../../data/load';

const c = loadCommunity();
const tiers = [...HIERARCHY_TIERS];
const tips = whoWeSeeMap(c);
const COLLAPSE_AT = 4;

function effectsForKind(
  effects: { kind: string; label: string; detail?: string; faces?: number[] }[],
  kind: string,
) {
  return effects.filter((e) => e.kind === kind);
}

function tipFor(name: string, slug?: string): string {
  if (slug && tips.has(slug)) return tips.get(slug)!;
  return tips.get(name.toLowerCase()) ?? '';
}
---

<CampaignLayout
  title="Community"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="community"
  source={c.source}
>
  <div class="toolbar">
    <span class="toolbar__lab">Scale</span>
    <button type="button" data-density-btn="compact">Compact</button>
    <button type="button" data-density-btn="normal">Normal</button>
    <button type="button" data-density-btn="roomy">Roomy</button>
  </div>

  <section class="surface" aria-labelledby="f-h">
    <h2 id="f-h">Fortunes</h2>
    <p class="lede">
      Community-wide pressure. Bars only — height and colour from Crisis to Abundance. Not a second
      character sheet.
    </p>
    <div class="fortune-chart" role="list">
      {
        Object.entries(c.fortunes).map(([k, v]) => (
          <div class="fortune" data-level={String(v)} role="listitem" title={FORTUNE_LABELS[v] ?? ''}>
            <div class="fortune__col" aria-hidden="true">
              <div class="fortune__fill" style={`--h: ${Math.max(14, (v / 3) * 100)}%`} />
            </div>
            <span class="fortune__name">{k}</span>
            <span class="fortune__state">{FORTUNE_LABELS[v] ?? ''}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="surface" aria-labelledby="h-h">
    <h2 id="h-h">Hierarchy</h2>
    <p class="lede">
      Every community member on every axis (default Outcast). Outsiders stand beside the ladders —
      not Outcast, not on any axis. Hover a name for “Who do we see?”
    </p>

    <div class="ruler">
      <span class="ruler__lab">Ruler</span>
      {
        c.ruler ? (
          c.rulerCharacterSlug ? (
            <a
              class="chip chip--pc"
              href={`/characters/${c.rulerCharacterSlug}/`}
              data-tip={tipFor(c.ruler, c.rulerCharacterSlug)}
            >
              {c.ruler}
            </a>
          ) : (
            <span class="chip" data-tip={tipFor(c.ruler)}>
              {c.ruler}
            </span>
          )
        ) : (
          <span class="empty">— none claimed —</span>
        )
      }
    </div>

    <div class="board">
      <div class="axes">
        {
          c.hierarchyAxes.map((axis) => {
            const onAxis = c.placements.filter((p) => p.axis === axis);
            return (
              <div class="axis" data-collapsed="false">
                <button type="button" class="axis__head" data-axis-toggle aria-expanded="true">
                  <span>{axis}</span>
                  <span style="color:#6a625c;font-size:0.85rem">{onAxis.length}</span>
                </button>
                <div class="axis__body">
                  {tiers.map((tier) => {
                    const members = onAxis.filter((p) => p.tier === tier);
                    const overflow = members.length > COLLAPSE_AT;
                    return (
                      <div
                        class="rung"
                        data-expandable={overflow ? 'true' : 'false'}
                        data-expanded="false"
                      >
                        <div class="rung__head">
                          <span class="rung__tier">{tier}</span>
                          <span class="rung__n">{members.length}</span>
                          {overflow && (
                            <button type="button" class="rung__expand" data-rung-expand>
                              Show all
                            </button>
                          )}
                        </div>
                        <div class="rung__members">
                          {members.length === 0 ? (
                            <span class="empty">—</span>
                          ) : (
                            members.map((m, i) => {
                              const hidden = overflow && i >= COLLAPSE_AT;
                              const tip = tipFor(m.name, m.characterSlug);
                              const cls = [
                                'chip',
                                m.characterSlug && 'chip--pc',
                                hidden && 'chip--overflow',
                              ]
                                .filter(Boolean)
                                .join(' ');
                              return m.characterSlug ? (
                                <a
                                  class={cls}
                                  href={`/characters/${m.characterSlug}/`}
                                  data-tip={tip}
                                  hidden={hidden || undefined}
                                >
                                  {m.name}
                                </a>
                              ) : (
                                <span class={cls} data-tip={tip} hidden={hidden || undefined}>
                                  {m.name}
                                </span>
                              );
                            })
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>

      <aside class="outsiders" aria-labelledby="o-h">
        <h3 id="o-h">Outsiders</h3>
        <p class="outsiders__lede">
          Not on any hierarchy. No Outcast status until they enter the community.
        </p>
        <ul>
          {
            (c.outsiders ?? []).length === 0 ? (
              <li class="empty">None tracked.</li>
            ) : (
              (c.outsiders ?? []).map((o) => (
                <li class="outsider" data-tip={o.note ?? ''}>
                  {o.characterSlug ? (
                    <a href={`/characters/${o.characterSlug}/`}>{o.name}</a>
                  ) : (
                    <strong>{o.name}</strong>
                  )}
                  {o.note && <span>{o.note}</span>}
                </li>
              ))
            )
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="surface" aria-labelledby="m-h">
    <h2 id="m-h">Foundation Myths</h2>
    <p class="lede">
      Effects by type. Hover a name for short description. Fire only when a roll tags the Myth.
    </p>
    <div class="scroll">
      <table class="matrix">
        <thead>
          <tr>
            <th>Myth</th>
            {MYTH_KIND_COLUMNS.map((col) => <th>{col.header}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            c.myths.length === 0 ? (
              <tr>
                <td colspan={1 + MYTH_KIND_COLUMNS.length} class="empty">
                  No active Foundation Myths.
                </td>
              </tr>
            ) : (
              c.myths.map((m) => (
                <tr>
                  <td>
                    <span class="matrix__name" title={m.summary ?? ''}>
                      {m.title}
                    </span>
                  </td>
                  {MYTH_KIND_COLUMNS.map((col) => {
                    const cells = effectsForKind(m.effects ?? [], col.kind);
                    return (
                      <td>
                        {cells.length === 0 ? (
                          <span class="empty">—</span>
                        ) : (
                          cells.map((e) => (
                            <span class="fx" data-kind={e.kind} title={e.detail ?? e.label}>
                              {e.label}
                              {e.faces?.length ? ` (${e.faces.join(', ')})` : ''}
                            </span>
                          ))
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </section>
</CampaignLayout>
