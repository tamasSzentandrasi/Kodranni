---
export const prerender = false;

import { HIERARCHY_TIERS } from '@kodranni/domain';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import {
  FORTUNE_LABELS,
  loadCommunity,
  MYTH_KIND_COLUMNS,
  whoWeSeeMap,
} from '../../data/load';
import { fortunePips } from '../../lib/format';

const c = loadCommunity();
const tiers = [...HIERARCHY_TIERS];
const tips = whoWeSeeMap(c);
const COLLAPSE_AT = 4; // show N chips then “+more” until expanded

function effectsForKind(
  effects: { kind: string; label: string; detail?: string; faces?: number[] }[],
  kind: string,
) {
  return effects.filter((e) => e.kind === kind);
}

function tipFor(name: string, slug?: string): string {
  if (slug && tips.has(slug)) return tips.get(slug)!;
  return tips.get(name.toLowerCase()) ?? '';
}
---

<CampaignLayout
  title="Community"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="community"
  source={c.source}
>
  <div class="kod-toolbar">
    <span class="kod-toolbar__label">Diagram scale</span>
    <button type="button" data-density-btn="compact" aria-pressed="false">Compact</button>
    <button type="button" data-density-btn="normal" aria-pressed="true">Normal</button>
    <button type="button" data-density-btn="roomy" aria-pressed="false">Roomy</button>
    <span class="kod-toolbar__hint">Collapse axis headers · expand crowded tiers</span>
  </div>

  <!-- Fortunes: visual pips, not raw arabic focus -->
  <section class="kod-section" aria-labelledby="fortunes-h">
    <h2 id="fortunes-h" class="kod-section__title">Fortunes</h2>
    <p class="kod-section__lede">
      Ambient pressure on the whole community. Marks are states, not a second character sheet.
    </p>
    <div class="kod-fortunes">
      {
        Object.entries(c.fortunes).map(([k, v]) => (
          <div class="kod-fortune" data-level={String(v)} title={`${k}: ${FORTUNE_LABELS[v] ?? v}`}>
            <span class="kod-fortune__name">{k}</span>
            <div class="kod-pips" aria-label={`${v} of 3`}>
              {fortunePips(v).map((on) => (
                <span class:list={['kod-pip', on && 'kod-pip--on']} />
              ))}
            </div>
            <span class="kod-fortune__state">{FORTUNE_LABELS[v] ?? ''}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Hierarchy board: axes + Outsiders side column -->
  <section class="kod-panel kod-panel--diagram" aria-labelledby="hier-h">
    <h2 id="hier-h">Hierarchy Diagram</h2>
    <p class="kod-section__lede">
      Every community member sits on <em>every</em> axis (usually Outcast). Outsiders stand
      <strong>beside</strong> the ladders — not Outcast, not on any axis — until inducted into the
      community. Hover a name for “Who do we see?”
    </p>

    <div class="kod-ruler-seat">
      <span class="kod-ruler-seat__label">Ruler</span>
      {
        c.ruler ? (
          c.rulerCharacterSlug ? (
            <a
              class="kod-member kod-member--pc"
              href={`/characters/${c.rulerCharacterSlug}/`}
              data-tip={tipFor(c.ruler, c.rulerCharacterSlug)}
            >
              {c.ruler}
            </a>
          ) : (
            <span class="kod-member" data-tip={tipFor(c.ruler)}>{c.ruler}</span>
          )
        ) : (
          <span class="kod-empty">— none claimed —</span>
        )
      }
    </div>

    <div class="kod-diagram-board">
      <div class="kod-axes">
        {
          c.hierarchyAxes.map((axis) => {
            const onAxis = c.placements.filter((p) => p.axis === axis);
            return (
              <div class="kod-axis" data-collapsed="false">
                <button
                  type="button"
                  class="kod-axis__head"
                  data-axis-toggle
                  aria-expanded="true"
                >
                  <span class="kod-axis__name">{axis}</span>
                  <span class="kod-axis__count">{onAxis.length}</span>
                </button>
                <div class="kod-axis__body">
                  {tiers.map((tier) => {
                    const members = onAxis.filter((p) => p.tier === tier);
                    const overflow = members.length > COLLAPSE_AT;
                    return (
                      <div
                        class="kod-rung"
                        data-tier={tier}
                        data-expandable={overflow ? 'true' : 'false'}
                        data-expanded="false"
                      >
                        <div class="kod-rung__head">
                          <span class="kod-rung__tier">{tier}</span>
                          <span class="kod-rung__n">{members.length}</span>
                          {overflow && (
                            <button
                              type="button"
                              class="kod-rung__expand"
                              data-rung-expand
                              aria-expanded="false"
                            >
                              Show all
                            </button>
                          )}
                        </div>
                        <div class="kod-rung__members">
                          {members.length === 0 ? (
                            <span class="kod-empty">—</span>
                          ) : (
                            members.map((m, i) => {
                              const hidden = overflow && i >= COLLAPSE_AT;
                              const tip = tipFor(m.name, m.characterSlug);
                              const cls = [
                                'kod-member',
                                m.characterSlug && 'kod-member--pc',
                                hidden && 'kod-member--overflow',
                              ]
                                .filter(Boolean)
                                .join(' ');
                              return m.characterSlug ? (
                                <a
                                  class={cls}
                                  href={`/characters/${m.characterSlug}/`}
                                  data-tip={tip}
                                  hidden={hidden || undefined}
                                >
                                  {m.name}
                                </a>
                              ) : (
                                <span class={cls} data-tip={tip} hidden={hidden || undefined}>
                                  {m.name}
                                </span>
                              );
                            })
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Outsiders: large side tier, not a hierarchy rung -->
      <aside class="kod-outsiders-rail" aria-labelledby="outsiders-h">
        <h3 id="outsiders-h" class="kod-outsiders-rail__title">Outsiders</h3>
        <p class="kod-outsiders-rail__lede">
          Not on any axis. No Outcast status until they enter the community.
        </p>
        <ul class="kod-outsider-list">
          {
            (c.outsiders ?? []).length === 0 ? (
              <li class="kod-empty">None tracked.</li>
            ) : (
              (c.outsiders ?? []).map((o) => (
                <li class="kod-outsider" data-tip={o.note ?? ''}>
                  {o.characterSlug ? (
                    <a href={`/characters/${o.characterSlug}/`}>{o.name}</a>
                  ) : (
                    <strong>{o.name}</strong>
                  )}
                  {o.note && <span class="kod-outsider__note">{o.note}</span>}
                </li>
              ))
            )
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="kod-panel" aria-labelledby="myths-h">
    <h2 id="myths-h">Foundation Myths</h2>
    <p class="kod-section__lede">
      Effects by type. Hover a myth name for its short description. Fire only when a roll tags the
      Myth.
    </p>
    <div class="kod-scroll">
      <table class="kod-myths">
        <thead>
          <tr>
            <th>Myth</th>
            {MYTH_KIND_COLUMNS.map((col) => <th>{col.header}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            c.myths.length === 0 ? (
              <tr>
                <td colspan={1 + MYTH_KIND_COLUMNS.length} class="kod-empty">
                  No active Foundation Myths.
                </td>
              </tr>
            ) : (
              c.myths.map((m) => (
                <tr>
                  <td>
                    <span class="kod-myth-name" title={m.summary ?? ''}>
                      {m.title}
                    </span>
                  </td>
                  {MYTH_KIND_COLUMNS.map((col) => {
                    const cells = effectsForKind(m.effects ?? [], col.kind);
                    return (
                      <td>
                        {cells.length === 0 ? (
                          <span class="kod-empty">—</span>
                        ) : (
                          cells.map((e) => (
                            <span class="kod-chip" data-kind={e.kind} title={e.detail ?? e.label}>
                              {e.label}
                              {e.faces?.length ? ` (${e.faces.join(', ')})` : ''}
                            </span>
                          ))
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <div id="kod-tip" class="kod-tip" role="tooltip" hidden></div>
</CampaignLayout>

<script is:inline>
  (function () {
    // Rung expand
    document.querySelectorAll('[data-rung-expand]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const rung = btn.closest('.kod-rung');
        if (!rung) return;
        const open = rung.getAttribute('data-expanded') === 'true';
        rung.setAttribute('data-expanded', open ? 'false' : 'true');
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        btn.textContent = open ? 'Show all' : 'Collapse';
        rung.querySelectorAll('.kod-member--overflow').forEach((el) => {
          if (open) el.setAttribute('hidden', '');
          else el.removeAttribute('hidden');
        });
      });
    });

    // Tooltip for data-tip
    const tip = document.getElementById('kod-tip');
    if (!tip) return;
    function showTip(el, text) {
      if (!text) return;
      tip.textContent = text;
      tip.hidden = false;
      const r = el.getBoundingClientRect();
      tip.style.left = Math.min(window.innerWidth - 220, Math.max(8, r.left)) + 'px';
      tip.style.top = Math.min(window.innerHeight - 80, r.bottom + 6) + 'px';
    }
    function hideTip() {
      tip.hidden = true;
    }
    document.querySelectorAll('[data-tip]').forEach((el) => {
      el.addEventListener('mouseenter', () => showTip(el, el.getAttribute('data-tip') || ''));
      el.addEventListener('mouseleave', hideTip);
      el.addEventListener('focus', () => showTip(el, el.getAttribute('data-tip') || ''));
      el.addEventListener('blur', hideTip);
    });
  })();
</script>
