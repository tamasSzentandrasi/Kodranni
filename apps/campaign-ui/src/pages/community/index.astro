---
export const prerender = false;

import { HIERARCHY_TIERS } from '@kodranni/domain';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import { FORTUNE_LABELS, loadCommunity, whoWeSeeMap } from '../../data/load';
import { AXIS_DOMAIN, AXIS_KEY, FORTUNE_BLURBS, factionHue } from '../../lib/format';

const c = loadCommunity();
const tiers = [...HIERARCHY_TIERS];
const tips = whoWeSeeMap(c);

function tipFor(name: string, slug?: string, placementNote?: string): string {
  if (placementNote) return placementNote;
  if (slug && tips.has(slug)) return tips.get(slug)!;
  return tips.get(name.toLowerCase()) ?? '';
}

const fortuneOrder = ['vitality', 'cohesion', 'surplus', 'standing', 'tradition'] as const;
---

<CampaignLayout
  title="Community"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="community"
  source={c.source}
>
  <section class="smoke" aria-labelledby="f-h">
    <div class="section-head">
      <h2 id="f-h">Fortunes</h2>
      <button
        type="button"
        class="info"
        data-tip="Community-wide pressure — not a second character sheet. Soft scale: Crisis 0 → Abundance 3."
        aria-label="About Fortunes"
      >
        i
      </button>
    </div>
    <div class="fortune-hall" role="list">
      {
        fortuneOrder.map((k) => {
          const v = c.fortunes[k] ?? 0;
          return (
            <div class="fortune" data-key={k} data-level={String(v)} role="listitem">
              <span class="fortune__icon" aria-hidden="true" />
              <span class="fortune__name">
                {k}
                <button
                  type="button"
                  class="info"
                  data-tip={FORTUNE_BLURBS[k] ?? ''}
                  aria-label={`About ${k}`}
                >
                  i
                </button>
              </span>
              <div class="fortune__meter" aria-hidden="true">
                {[0, 1, 2, 3].map((i) => (
                  <span class:list={['fortune__pip', i <= v && 'fortune__pip--on']} />
                ))}
              </div>
              <span class="fortune__state">{FORTUNE_LABELS[v] ?? ''}</span>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="smoke" aria-labelledby="h-h">
    <div class="section-head">
      <h2 id="h-h">Hierarchy</h2>
      <button
        type="button"
        class="info"
        data-tip="One crown, then parallel ladders. Same four tiers on every axis (Honoured → Outcast). Colour marks the axis; saturation falls toward Outcast. Hover names for who they are."
        aria-label="About Hierarchy"
      >
        i
      </button>
    </div>

    <div class="hier-diagram">
      <div class="hier-ruler">
        <p class="hier-ruler__title">Ruler</p>
        {
          c.ruler ? (
            c.rulerCharacterSlug ? (
              <a
                class="member member--pc"
                href={`/characters/${c.rulerCharacterSlug}/`}
                data-tip={tipFor(c.ruler, c.rulerCharacterSlug)}
                style="display:inline-flex;margin:0.35rem auto 0"
              >
                <span class="member__dot" />
                {c.ruler}
              </a>
            ) : (
              <span class="member" data-tip={tipFor(c.ruler)} style="display:inline-flex;margin:0.35rem auto 0">
                <span class="member__dot" />
                {c.ruler}
              </span>
            )
          ) : (
            <p class="hier-ruler__note">One seat for the whole community — none claimed.</p>
          )
        }
      </div>
      <p class="hier-join" aria-hidden="true">↓ · ↓ · ↓ · ↓</p>

      <div class="hier-board">
        <div class="hier-axes">
          {
            c.hierarchyAxes.map((axis) => {
              const onAxis = c.placements.filter((p) => p.axis === axis);
              const key = AXIS_KEY[axis] ?? axis.toLowerCase();
              return (
                <div class="hier-axis" data-axis={key}>
                  <div class="hier-axis__head">
                    <p class="hier-axis__name">{axis}</p>
                    <p class="hier-axis__domain">{AXIS_DOMAIN[axis] ?? ''}</p>
                    <span class="hier-axis__count">{onAxis.length} placed</span>
                  </div>
                  <ol class="hier-rungs">
                    {tiers.map((tier, ti) => {
                      const members = onAxis.filter((p) => p.tier === tier);
                      const empty = members.length === 0;
                      const defaultCollapsed = empty || (tier === 'Outcast' && members.length > 5);
                      return (
                        <li
                          class="hier-rung"
                          data-tier={tier}
                          data-collapsed={defaultCollapsed ? 'true' : 'false'}
                        >
                          <button
                            type="button"
                            class="hier-rung__head"
                            data-rung-toggle
                            aria-expanded={defaultCollapsed ? 'false' : 'true'}
                          >
                            <span class="hier-rung__tier">{tier}</span>
                            <span class="hier-rung__n">{members.length}</span>
                            <span class="hier-rung__chev" aria-hidden="true">
                              {defaultCollapsed ? '▸' : '▾'}
                            </span>
                          </button>
                          <ul class="hier-rung__members">
                            {empty ? (
                              <li class="empty">—</li>
                            ) : (
                              members.map((m) => {
                                const tip = tipFor(m.name, m.characterSlug, m.note);
                                return (
                                  <li>
                                    {m.characterSlug ? (
                                      <a
                                        class="member member--pc"
                                        href={`/characters/${m.characterSlug}/`}
                                        data-tip={tip}
                                      >
                                        <span class="member__dot" />
                                        {m.name}
                                      </a>
                                    ) : (
                                      <span class="member" data-tip={tip} tabindex="0">
                                        <span class="member__dot" />
                                        {m.name}
                                      </span>
                                    )}
                                  </li>
                                );
                              })
                            )}
                          </ul>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              );
            })
          }
        </div>

        <aside class="outsiders" aria-labelledby="o-h">
          <div class="section-head" style="margin:0">
            <h3 id="o-h">Outsiders</h3>
            <button
              type="button"
              class="info"
              data-tip="Named individuals only. Faction is a coloured property. Not on any ladder until inducted."
              aria-label="About Outsiders"
            >
              i
            </button>
          </div>
          <ul class="outsiders__list">
            {
              (c.outsiders ?? []).length === 0 ? (
                <li class="empty">None tracked.</li>
              ) : (
                (c.outsiders ?? []).map((o) => {
                  const hue = o.faction ? factionHue(o.faction) : 0;
                  return (
                    <li
                      class="outsider"
                      style={o.faction ? `--faction-h: ${hue}` : undefined}
                    >
                      {o.characterSlug ? (
                        <a class="outsider__name" href={`/characters/${o.characterSlug}/`}>
                          {o.name}
                        </a>
                      ) : (
                        <span class="outsider__name">{o.name}</span>
                      )}
                      {o.faction && <span class="outsider__faction">{o.faction}</span>}
                      {o.note && (
                        <button
                          type="button"
                          class="info"
                          data-tip={o.note}
                          aria-label={`About ${o.name}`}
                        >
                          i
                        </button>
                      )}
                    </li>
                  );
                })
              )
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="smoke" aria-labelledby="m-h">
    <div class="section-head">
      <h2 id="m-h">Foundation Myths</h2>
      <button
        type="button"
        class="info"
        data-tip="Active myths of this community. Effects fire only when a roll tags the Myth."
        aria-label="About Foundation Myths"
      >
        i
      </button>
    </div>
    {
      c.myths.length === 0 ? (
        <p class="empty">No active Foundation Myths.</p>
      ) : (
        <div class="myth-list">
          {c.myths.map((m) => (
            <article class="myth-card">
              <h3 class="myth-card__title">
                {m.title}
                {m.summary && (
                  <button
                    type="button"
                    class="info"
                    data-tip={m.summary}
                    aria-label={`About ${m.title}`}
                  >
                    i
                  </button>
                )}
              </h3>
              <div class="myth-card__fx">
                {(m.effects ?? []).length === 0 ? (
                  <span class="empty">No listed effects.</span>
                ) : (
                  (m.effects ?? []).map((e) => (
                    <span class="fx" data-kind={e.kind}>
                      {e.label}
                      {e.faces?.length ? ` (${e.faces.join(', ')})` : ''}
                      {e.detail && (
                        <button
                          type="button"
                          class="info"
                          data-tip={e.detail}
                          aria-label="Effect detail"
                        >
                          i
                        </button>
                      )}
                    </span>
                  ))
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</CampaignLayout>
