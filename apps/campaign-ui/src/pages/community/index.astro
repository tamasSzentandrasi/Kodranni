---
export const prerender = false;

import { HIERARCHY_TIERS } from '@kodranni/domain';
import CampaignLayout from '../../layouts/CampaignLayout.astro';
import {
  FORTUNE_LABELS,
  loadCommunity,
  whoWeSeeMap,
} from '../../data/load';
import { FORTUNE_BLURBS, factionHue } from '../../lib/format';

const c = loadCommunity();
const tiers = [...HIERARCHY_TIERS];
const tips = whoWeSeeMap(c);

function tipFor(name: string, slug?: string, placementNote?: string): string {
  if (placementNote) return placementNote;
  if (slug && tips.has(slug)) return tips.get(slug)!;
  return tips.get(name.toLowerCase()) ?? '';
}

const fortuneOrder = ['vitality', 'cohesion', 'surplus', 'standing', 'tradition'] as const;
---

<CampaignLayout
  title="Community"
  communityName={c.name}
  generatedAt={c.generatedAt}
  primary="community"
  source={c.source}
>
  <section class="surface" aria-labelledby="f-h">
    <div class="section-head">
      <h2 id="f-h">Fortunes</h2>
      <button
        type="button"
        class="info"
        data-tip="Community-wide pressure — not a second character sheet. Soft scale: Crisis 0 → Abundance 3. Colours every scene for PCs and NPCs alike."
        aria-label="About Fortunes"
      >
        i
      </button>
    </div>
    <div class="fortune-hall" role="list">
      {
        fortuneOrder.map((k) => {
          const v = c.fortunes[k] ?? 0;
          return (
            <div
              class="fortune"
              data-key={k}
              data-level={String(v)}
              role="listitem"
            >
              <span class="fortune__icon" aria-hidden="true" />
              <span class="fortune__name">
                {k}
                <button
                  type="button"
                  class="info"
                  data-tip={FORTUNE_BLURBS[k] ?? ''}
                  aria-label={`About ${k}`}
                >
                  i
                </button>
              </span>
              <div class="fortune__meter" aria-hidden="true">
                {[0, 1, 2, 3].map((i) => (
                  <span class:list={['fortune__pip', i <= v && 'fortune__pip--on']} />
                ))}
              </div>
              <span class="fortune__state">{FORTUNE_LABELS[v] ?? ''}</span>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="surface" aria-labelledby="h-h">
    <div class="section-head">
      <h2 id="h-h">Hierarchy</h2>
      <button
        type="button"
        class="info"
        data-tip="Every community member on every axis (default Outcast). Collapse axes or tiers. Hover a name for who they are. Outsiders stand beside the ladders."
        aria-label="About Hierarchy"
      >
        i
      </button>
    </div>

    <div class="ruler">
      <span class="ruler__lab">Ruler</span>
      {
        c.ruler ? (
          c.rulerCharacterSlug ? (
            <a
              class="member member--pc"
              href={`/characters/${c.rulerCharacterSlug}/`}
              data-tip={tipFor(c.ruler, c.rulerCharacterSlug)}
            >
              <span class="member__dot" />
              {c.ruler}
            </a>
          ) : (
            <span class="member" data-tip={tipFor(c.ruler)}>
              <span class="member__dot" />
              {c.ruler}
            </span>
          )
        ) : (
          <span class="empty">— none claimed —</span>
        )
      }
    </div>

    <div class="board">
      <div class="axes">
        {
          c.hierarchyAxes.map((axis) => {
            const onAxis = c.placements.filter((p) => p.axis === axis);
            return (
              <div class="axis" data-collapsed="false">
                <button
                  type="button"
                  class="axis__head"
                  data-axis-toggle
                  aria-expanded="true"
                >
                  <span>{axis}</span>
                  <span class="axis__count">{onAxis.length}</span>
                </button>
                <div class="axis__body">
                  {tiers.map((tier) => {
                    const members = onAxis.filter((p) => p.tier === tier);
                    const empty = members.length === 0;
                    // Collapse empty tiers and Outcast when crowded
                    const defaultCollapsed =
                      empty || (tier === 'Outcast' && members.length > 6);
                    return (
                      <div
                        class:list={['rung', empty && 'rung--empty']}
                        data-collapsed={defaultCollapsed ? 'true' : 'false'}
                      >
                        <button
                          type="button"
                          class="rung__head"
                          data-rung-toggle
                          aria-expanded={defaultCollapsed ? 'false' : 'true'}
                        >
                          <span class="rung__tier">{tier}</span>
                          <span class="rung__n">{members.length}</span>
                          <span class="rung__chev" aria-hidden="true">▾</span>
                        </button>
                        <ul class="rung__members">
                          {empty ? (
                            <li class="empty">—</li>
                          ) : (
                            members.map((m) => {
                              const tip = tipFor(m.name, m.characterSlug, m.note);
                              return (
                                <li>
                                  {m.characterSlug ? (
                                    <a
                                      class="member member--pc"
                                      href={`/characters/${m.characterSlug}/`}
                                      data-tip={tip}
                                    >
                                      <span class="member__dot" />
                                      {m.name}
                                    </a>
                                  ) : (
                                    <span class="member" data-tip={tip} tabindex="0">
                                      <span class="member__dot" />
                                      {m.name}
                                    </span>
                                  )}
                                </li>
                              );
                            })
                          )}
                        </ul>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>

      <aside class="outsiders" aria-labelledby="o-h">
        <div class="section-head" style="border:none;margin:0;padding:0">
          <h3 id="o-h">Outsiders</h3>
          <button
            type="button"
            class="info"
            data-tip="Named individuals only — never a whole faction as one entry. Faction is a property (colour). Not on any hierarchy until inducted."
            aria-label="About Outsiders"
          >
            i
          </button>
        </div>
        <ul class="outsiders__list">
          {
            (c.outsiders ?? []).length === 0 ? (
              <li class="empty">None tracked.</li>
            ) : (
              (c.outsiders ?? []).map((o) => {
                const hue = o.faction ? factionHue(o.faction) : 0;
                return (
                  <li
                    class="outsider"
                    style={o.faction ? `--faction-h: ${hue}` : undefined}
                  >
                    {o.characterSlug ? (
                      <a class="outsider__name" href={`/characters/${o.characterSlug}/`}>
                        {o.name}
                      </a>
                    ) : (
                      <span class="outsider__name">{o.name}</span>
                    )}
                    {o.faction && <span class="outsider__faction">{o.faction}</span>}
                    {o.note && (
                      <button
                        type="button"
                        class="info"
                        data-tip={o.note}
                        aria-label={`About ${o.name}`}
                      >
                        i
                      </button>
                    )}
                  </li>
                );
              })
            )
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="surface" aria-labelledby="m-h">
    <div class="section-head">
      <h2 id="m-h">Foundation Myths</h2>
      <button
        type="button"
        class="info"
        data-tip="Active myths of this community. Effects fire only when a roll tags the Myth. Hover chips for detail."
        aria-label="About Foundation Myths"
      >
        i
      </button>
    </div>
    {
      c.myths.length === 0 ? (
        <p class="empty">No active Foundation Myths.</p>
      ) : (
        <div class="myth-list">
          {c.myths.map((m) => (
            <article class="myth-card">
              <h3 class="myth-card__title">
                {m.title}
                {m.summary && (
                  <button
                    type="button"
                    class="info"
                    data-tip={m.summary}
                    aria-label={`About ${m.title}`}
                  >
                    i
                  </button>
                )}
              </h3>
              <div class="myth-card__fx">
                {(m.effects ?? []).length === 0 ? (
                  <span class="empty">No listed effects.</span>
                ) : (
                  (m.effects ?? []).map((e) => (
                    <span class="fx" data-kind={e.kind}>
                      {e.label}
                      {e.faces?.length ? ` (${e.faces.join(', ')})` : ''}
                      {e.detail && (
                        <button
                          type="button"
                          class="info"
                          data-tip={e.detail}
                          aria-label="Effect detail"
                        >
                          i
                        </button>
                      )}
                    </span>
                  ))
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</CampaignLayout>
