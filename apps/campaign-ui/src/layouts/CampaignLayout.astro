---
import '@kodranni/design/campaign.css';

interface Props {
  title: string;
  communityName: string;
  generatedAt: string;
  current?: string;
  source?: string;
  navCharacters?: { slug: string; name: string }[];
}

const {
  title,
  communityName,
  generatedAt,
  current = 'home',
  source = 'fixture',
  navCharacters = [],
} = Astro.props;

const asOf = new Date(generatedAt).toLocaleString(undefined, {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const sourceLabel =
  source === 'live' ? 'live store' : source === 'snapshot' ? 'export snapshot' : 'fixture';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>{title} · {communityName}</title>
  </head>
  <body>
    <div class="kod-shell">
      <header class="kod-brand">
        <span class="kod-brand__mark">Kodranni</span>
        <h1 class="kod-brand__title">{communityName}</h1>
      </header>
      <p class="kod-meta">
        As of {asOf} · shared record (read-only) · <span class="kod-source">{sourceLabel}</span>
      </p>
      <nav class="kod-nav" aria-label="Campaign">
        <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Overview</a>
        <a href="/tracker/" aria-current={current === 'tracker' ? 'page' : undefined}>Tracker</a>
        {
          navCharacters.map((ch) => (
            <a
              href={`/characters/${ch.slug}/`}
              aria-current={current === ch.slug ? 'page' : undefined}
            >
              {ch.name}
            </a>
          ))
        }
      </nav>
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .kod-source {
    color: var(--kod-silver-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
</style>
