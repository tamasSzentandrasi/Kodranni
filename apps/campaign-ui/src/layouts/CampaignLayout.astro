---
import '@kodranni/design/campaign.css';

interface Props {
  title: string;
  communityName: string;
  generatedAt: string;
  primary: 'community' | 'characters';
  source?: string;
  density?: string;
}

const {
  title,
  communityName,
  generatedAt,
  primary,
  source = 'fixture',
  density = 'normal',
} = Astro.props;

const asOf = new Date(generatedAt).toLocaleString(undefined, {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const sourceLabel =
  source === 'live' ? 'live store' : source === 'snapshot' ? 'export snapshot' : 'fixture';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>{title} · {communityName}</title>
  </head>
  <body data-density={density}>
    <div class="kod-shell kod-shell--wide">
      <header class="kod-brand">
        <span class="kod-brand__mark">Kodranni</span>
        <h1 class="kod-brand__title">{communityName}</h1>
      </header>
      <p class="kod-meta">
        As of {asOf} · read-only living record · <span class="kod-source">{sourceLabel}</span>
      </p>

      <nav class="kod-primary-tabs" aria-label="Primary">
        <a href="/community/" aria-current={primary === 'community' ? 'page' : undefined}
          >Community</a
        >
        <a href="/characters/" aria-current={primary === 'characters' ? 'page' : undefined}
          >Characters</a
        >
      </nav>

      <slot />
    </div>
    <script is:inline>
      (function () {
        const key = 'kod-density';
        const saved = localStorage.getItem(key);
        if (saved) document.body.setAttribute('data-density', saved);
        document.querySelectorAll('[data-density-btn]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const d = btn.getAttribute('data-density-btn');
            document.body.setAttribute('data-density', d);
            localStorage.setItem(key, d);
            document.querySelectorAll('[data-density-btn]').forEach((b) => {
              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
            });
          });
        });
        document.querySelectorAll('[data-axis-toggle]').forEach((head) => {
          head.addEventListener('click', () => {
            const axis = head.closest('.kod-axis');
            if (!axis) return;
            const collapsed = axis.getAttribute('data-collapsed') === 'true';
            axis.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
            head.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .kod-source {
    color: var(--kod-silver-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
</style>
