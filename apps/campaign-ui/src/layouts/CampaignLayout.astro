---
import '@kodranni/design/campaign.css';

interface Props {
  title: string;
  communityName: string;
  generatedAt: string;
  primary: 'community' | 'characters';
  source?: string;
}

const { title, communityName, generatedAt, primary, source = 'fixture' } = Astro.props;

const asOf = new Date(generatedAt).toLocaleString(undefined, {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const sourceLabel =
  source === 'live' ? 'live store' : source === 'snapshot' ? 'export' : 'fixture';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>{title} · {communityName}</title>
  </head>
  <body data-density="normal">
    <div class="app">
      <header class="app__brand">
        <span class="app__mark">Kodranni</span>
        <h1 class="app__title">{communityName}</h1>
      </header>
      <p class="app__meta">
        As of {asOf} · living record (read-only) · <span class="src">{sourceLabel}</span>
      </p>

      <nav class="tabs" aria-label="Primary">
        <a href="/community/" aria-current={primary === 'community' ? 'page' : undefined}
          >Community</a
        >
        <a href="/characters/" aria-current={primary === 'characters' ? 'page' : undefined}
          >Characters</a
        >
      </nav>

      <slot />
    </div>

    <div id="kod-tip" class="tip" role="tooltip" hidden></div>

    <script is:inline>
      (function () {
        const densKey = 'kod-density';
        const saved = localStorage.getItem(densKey);
        if (saved) document.body.setAttribute('data-density', saved);
        function syncDens() {
          const d = document.body.getAttribute('data-density') || 'normal';
          document.querySelectorAll('[data-density-btn]').forEach((b) => {
            b.setAttribute(
              'aria-pressed',
              b.getAttribute('data-density-btn') === d ? 'true' : 'false',
            );
          });
        }
        syncDens();
        document.querySelectorAll('[data-density-btn]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const d = btn.getAttribute('data-density-btn');
            document.body.setAttribute('data-density', d);
            localStorage.setItem(densKey, d);
            syncDens();
          });
        });
        document.querySelectorAll('[data-axis-toggle]').forEach((head) => {
          head.addEventListener('click', () => {
            const axis = head.closest('.axis');
            if (!axis) return;
            const c = axis.getAttribute('data-collapsed') === 'true';
            axis.setAttribute('data-collapsed', c ? 'false' : 'true');
            head.setAttribute('aria-expanded', c ? 'true' : 'false');
          });
        });
        document.querySelectorAll('[data-rung-expand]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const rung = btn.closest('.rung');
            if (!rung) return;
            const open = rung.getAttribute('data-expanded') === 'true';
            rung.setAttribute('data-expanded', open ? 'false' : 'true');
            btn.textContent = open ? 'Show all' : 'Collapse';
            rung.querySelectorAll('.chip--overflow').forEach((el) => {
              if (open) el.setAttribute('hidden', '');
              else el.removeAttribute('hidden');
            });
          });
        });
        const tip = document.getElementById('kod-tip');
        if (tip) {
          function show(el, text) {
            if (!text) return;
            tip.textContent = text;
            tip.hidden = false;
            const r = el.getBoundingClientRect();
            tip.style.left = Math.min(window.innerWidth - 240, Math.max(8, r.left)) + 'px';
            tip.style.top = Math.min(window.innerHeight - 90, r.bottom + 6) + 'px';
          }
          function hide() {
            tip.hidden = true;
          }
          document.querySelectorAll('[data-tip]').forEach((el) => {
            el.addEventListener('mouseenter', () => show(el, el.getAttribute('data-tip') || ''));
            el.addEventListener('mouseleave', hide);
            el.addEventListener('focus', () => show(el, el.getAttribute('data-tip') || ''));
            el.addEventListener('blur', hide);
          });
        }
      })();
    </script>
  </body>
</html>
