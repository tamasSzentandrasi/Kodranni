{
  "name": "@kodranni/campaign-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 8742 --force",
    "build:map": "esbuild src/lib/map-entry.ts --bundle --minify --format=iife --outfile=public/map-bundle.js --alias:three/addons=three/examples/jsm",
    "build": "npm run build:map && astro build",
    "preview": "astro preview --port 8742",
    "test": "NODE_OPTIONS='--experimental-sqlite' vitest run"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.1",
    "@kodranni/app": "*",
    "@kodranni/bot-runtime": "*",
    "@kodranni/design": "*",
    "@kodranni/domain": "*",
    "@kodranni/hall-render": "*",
    "@kodranni/store": "*",
    "3d-force-graph": "^1.80.0",
    "astro": "^7.0.0",
    "three": "^0.186.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "vitest": "^3.0.9"
  }
}
