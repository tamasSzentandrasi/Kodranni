---
import { chapterIcons, slugFromEntryId } from '../../lib/chapter-icons';

const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const slug = slugFromEntryId(entry.id);
const iconSrc = chapterIcons[slug] ?? null;
---

<div class="kod-page-title">
	{
		iconSrc && (
			<img class="kod-page-title__icon" src={iconSrc} alt="" width="64" height="64" decoding="async" />
		)
	}
	<h1 id="_top">{title}</h1>
</div>
