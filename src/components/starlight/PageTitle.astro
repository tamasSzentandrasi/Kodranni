---
import {
	chapterIcons,
	chapterKickerFor,
	chapterParentSlug,
	chapterRoses,
	slugFromEntryId,
} from '../../lib/chapter-icons';

const { entry, lang } = Astro.locals.starlightRoute;
const title = entry.data.title;
const slug = slugFromEntryId(entry.id);
const iconSrc = chapterIcons[slug] ?? null;
const roseSrc = chapterRoses[slug] ?? null;
const kicker = chapterKickerFor(slug, lang);
const parentSlug = chapterParentSlug(slug);
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const parentHref = parentSlug
	? `${base}${lang === 'hu' ? 'hu/' : ''}${parentSlug}/`
	: null;
---

<header
	class="kod-page-title"
	data-slug={slug}
>
	{
		roseSrc ? (
			<figure class="kod-page-title__rose">
				<img src={roseSrc} alt="" width="1024" height="1024" fetchpriority="high" />
			</figure>
		) : iconSrc ? (
			<span class="kod-page-title__mark">
				<span
					class="kod-page-title__icon"
					style={`--kod-icon-mask: url("${iconSrc}")`}
					aria-hidden="true"
				/>
			</span>
		) : null
	}
	<div class="kod-page-title__text">
		{
			kicker && parentHref ? (
				<a class="kod-page-title__kicker" href={parentHref}>
					{kicker}
				</a>
			) : kicker ? (
				<p class="kod-page-title__kicker">{kicker}</p>
			) : null
		}
		<h1 id="_top">{title}</h1>
	</div>
</header>
