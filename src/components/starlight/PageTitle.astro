---
import { chapterIcons, chapterKickerFor, slugFromEntryId } from '../../lib/chapter-icons';

const { entry, lang } = Astro.locals.starlightRoute;
const title = entry.data.title;
const slug = slugFromEntryId(entry.id);
const iconSrc = chapterIcons[slug] ?? null;
const kicker = chapterKickerFor(slug, lang);
---

<div class="kod-page-title">
	{
		iconSrc && (
			<span class="kod-page-title__mark" data-slug={slug}>
				<span
					class="kod-page-title__icon"
					style={`--kod-icon-mask: url("${iconSrc}")`}
					aria-hidden="true"
				></span>
			</span>
		)
	}
	<div class="kod-page-title__text">
		{kicker && <span class="kod-page-title__kicker">{kicker}</span>}
		<h1 id="_top">{title}</h1>
	</div>
</div>
