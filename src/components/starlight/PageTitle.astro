---
import { chapterIcons, slugFromEntryId } from '../../lib/chapter-icons';

const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const slug = slugFromEntryId(entry.id);
const iconSrc = chapterIcons[slug] ?? null;
---

<div class="kod-page-title">
	{
		iconSrc && (
			<span
				class="kod-page-title__mark"
				data-slug={slug}
			>
				<span
					class="kod-page-title__icon"
					style={`--kod-icon-mask: url("${iconSrc}")`}
					aria-hidden="true"
				></span>
			</span>
		)
	}
	<h1 id="_top">{title}</h1>
</div>
