---
import Default from '@astrojs/starlight/components/Head.astro';
import barNight from '@kodranni/design/ornament/btn-bar-night.png?url';
import barMoon from '@kodranni/design/ornament/btn-bar-moon.png?url';
import roundNight from '@kodranni/design/ornament/btn-round.png?url';
import roundMoon from '@kodranni/design/ornament/btn-round-moon.png?url';
import pagePrev from '@kodranni/design/ornament/page-prev.png?url';
import pageNext from '@kodranni/design/ornament/page-next.png?url';
import { chapterRoses, slugFromEntryId } from '../../lib/chapter-icons';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const icon = (name: string) => `${base}${name}`;
const fontBellefairLatin = icon('fonts/bellefair/bellefair-latin-400-normal.woff2');
const fontBellefairLatinExt = icon('fonts/bellefair/bellefair-latin-ext-400-normal.woff2');
const fontRunic = icon('fonts/noto-sans-runic/noto-sans-runic-400-normal.woff2');
let roseSrc: string | undefined;
try {
	const entry = Astro.locals.starlightRoute?.entry;
	if (entry) roseSrc = chapterRoses[slugFromEntryId(entry.id)];
} catch {
	roseSrc = undefined;
}
const ogImage = Astro.site
	? new URL(`${base}og.jpg`, Astro.site).href
	: icon('og.jpg');
const fontFacesCss = `
@font-face {
  font-family: 'Bellefair';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${fontBellefairLatinExt}') format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308,
    U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
    U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'Bellefair';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${fontBellefairLatin}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304,
    U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Noto Sans Runic';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${fontRunic}') format('woff2');
}
`;
---

<link rel="preload" href={fontBellefairLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={barNight} as="image" />
<link rel="preload" href={barMoon} as="image" />
<link rel="preload" href={roundNight} as="image" />
<link rel="preload" href={roundMoon} as="image" />
<link rel="preload" href={pagePrev} as="image" />
<link rel="preload" href={pageNext} as="image" />
{roseSrc ? <link rel="preload" href={roseSrc} as="image" fetchpriority="high" /> : null}

<style is:global set:html={fontFacesCss} />

<Default><slot /></Default>
<link rel="icon" href={icon('favicon.ico')} sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href={icon('favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={icon('favicon-16x16.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={icon('apple-touch-icon.png')} />
<meta name="theme-color" content="#8a1515" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="The Kodranni falcon on a blood disc." />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="The Kodranni falcon on a blood disc." />

<script>
	import { chapterIcons, hrefSegmentToSlug } from '../../lib/chapter-icons';
	import { boot } from '../../scripts/guidebook/enhance';

	const sidebarIconMap: Record<string, string> = {};
	for (const [seg, slug] of Object.entries(hrefSegmentToSlug)) {
		const src = chapterIcons[slug];
		if (src) sidebarIconMap[seg] = src;
	}
	boot(sidebarIconMap);
</script>
