---
import Default from '@astrojs/starlight/components/Head.astro';
import { chapterIcons } from '../../lib/chapter-icons';

const sidebarIconMap: Record<string, string> = {
	'': chapterIcons.index,
	introduction: chapterIcons.introduction,
	'dice-mechanics': chapterIcons['dice-mechanics'],
	glossary: chapterIcons.glossary,
	'human-potential': chapterIcons['human-potential'],
	foundations: chapterIcons.foundations,
	skills: chapterIcons.skills,
	traits: chapterIcons.traits,
	exertion: chapterIcons.exertion,
	harm: chapterIcons.harm,
	echoes: chapterIcons.echoes,
	hierarchies: chapterIcons.hierarchies,
	inventory: chapterIcons.inventory,
	'campaign-setup': chapterIcons['campaign-setup'],
	'character-creation': chapterIcons['character-creation'],
	automation: chapterIcons.automation,
};

// Astro BASE_URL may or may not end with /
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const icon = (name: string) => `${base}${name}`;
---

<Default><slot /></Default>
{/*
  Favicon stack — why this exists:
  - Project Pages live under /Kodranni/Guidebook/, so root /favicon.ico is wrong.
  - SVG favicons were ignored or cached-as-broken in some Chromium tabs.
  - ICO + sized PNGs is the most portable set for browser tabs.
*/}
<link rel="icon" href={icon('favicon.ico')} sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href={icon('favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={icon('favicon-16x16.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={icon('apple-touch-icon.png')} />
<meta name="theme-color" content="#8a1515" />

{/* NOT is:inline — define:vars must be processed by Astro/Vite */}
<script define:vars={{ sidebarIconMap }}>
	function segmentFromHref(href) {
		try {
			const path = new URL(href, window.location.origin).pathname.replace(/\/+$/, '');
			const parts = path.split('/').filter(Boolean);
			// Drop Pages prefix segments when present
			if (parts[0] && parts[0].toLowerCase() === 'kodranni') parts.shift();
			if (parts[0] && parts[0].toLowerCase() === 'guidebook') parts.shift();
			return parts[0] || '';
		} catch {
			return '';
		}
	}

	function inject() {
		const root = document.getElementById('starlight__sidebar');
		if (!root) return;
		root.querySelectorAll('a[href]').forEach((a) => {
			if (a.querySelector('img.kod-sidebar-icon')) return;
			const seg = segmentFromHref(a.getAttribute('href') || '');
			const src = sidebarIconMap[seg];
			if (!src) return;
			const img = document.createElement('img');
			img.className = 'kod-sidebar-icon';
			img.src = src;
			img.alt = '';
			img.width = 18;
			img.height = 18;
			img.decoding = 'async';
			a.insertBefore(img, a.firstChild);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', inject);
	} else {
		inject();
	}
	document.addEventListener('astro:page-load', inject);
</script>
