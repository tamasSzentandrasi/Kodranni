---
import config from 'virtual:starlight/user-config';

const currentLocale = Astro.locals.starlightRoute.locale;
const lang = Astro.locals.starlightRoute.lang;
const groupLabel = lang === 'hu' ? 'Nyelv' : 'Language';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL.slice(0, -1)
	: import.meta.env.BASE_URL;

function hrefFor(code: string): string {
	const target = code === 'root' ? undefined : code;
	let path = Astro.url.pathname;
	if (base && path.startsWith(base)) path = path.slice(base.length) || '/';
	if (!path.startsWith('/')) path = `/${path}`;
	if (currentLocale) {
		path = path.replace(new RegExp(`^/${currentLocale}(?=/|$)`), '') || '/';
	}
	if (target) {
		path = `/${target}${path === '/' ? '/' : path}`;
	}
	if (!path.endsWith('/') && !path.includes('.')) path += '/';
	return `${base}${path}`;
}

const locales = config.locales ?? {};
const options = Object.entries(locales).map(([code, locale]) => ({
	code,
	href: hrefFor(code),
	label: locale!.label,
	current: code === (currentLocale ?? 'root'),
}));
---

{
	config.isMultilingual && (
		<nav class="kod-lang" aria-label={groupLabel}>
			{
				options.map(({ code, href, label, current }) => (
					<a
						href={href}
						class:list={['kod-lang__link', { 'is-current': current }]}
						lang={code === 'root' ? 'en' : code}
						hreflang={code === 'root' ? 'en' : code}
						aria-label={label}
						aria-current={current ? 'true' : undefined}
					>
						{code === 'hu' ? (
							<svg class="kod-lang__flag" viewBox="0 0 60 36" aria-hidden="true" focusable="false">
								<rect width="60" height="12" fill="#ce2939"></rect>
								<rect y="12" width="60" height="12" fill="#f2efe9"></rect>
								<rect y="24" width="60" height="12" fill="#477050"></rect>
							</svg>
						) : (
							<svg class="kod-lang__flag" viewBox="0 0 60 36" aria-hidden="true" focusable="false">
								<rect width="60" height="36" fill="#012169"></rect>
								<path d="M0 0 L60 36 M60 0 L0 36" stroke="#fff" stroke-width="8"></path>
								<path d="M0 0 L60 36 M60 0 L0 36" stroke="#c8102e" stroke-width="4"></path>
								<path d="M30 0 V36 M0 18 H60" stroke="#fff" stroke-width="12"></path>
								<path d="M30 0 V36 M0 18 H60" stroke="#c8102e" stroke-width="7"></path>
							</svg>
						)}
					</a>
				))
			}
		</nav>
	)
}
