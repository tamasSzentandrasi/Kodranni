[Unit]
Description=Kodranni table (optional always-live)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-%E/kodranni/service.env
ExecStart=kodranni start
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=90
KillMode=mixed

[Install]
WantedBy=default.target
