{
  "name": "kodranni",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "test:guidebook": "npm run test:domain && node scripts/guidebook-integrity.mjs",
    "build": "npm run test:guidebook && astro build && node scripts/prefix-base.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test --workspaces --if-present",
    "test:domain": "npm run test -w @kodranni/domain",
    "dev:campaign-ui": "NODE_OPTIONS='--experimental-sqlite' npm run dev -w @kodranni/campaign-ui",
    "build:campaign-ui": "NODE_OPTIONS='--experimental-sqlite' npm run build -w @kodranni/campaign-ui",
    "kodranni": "npm run start -w @kodranni/cli --"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.0",
    "astro": "^7.0.0",
    "sharp": "^0.33.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
